# ====================================================================
# AUTO-RECON AI — Backend Environment Configuration Template
# ====================================================================
# For LOCAL DEVELOPMENT:
#   Copy this file to .env and configure your local MySQL credentials.
#
# For PRODUCTION DEPLOYMENT (Render Free + TiDB Cloud Starter):
#   Set these environment variables directly in Render Dashboard > Environment.
#   NEVER commit actual production passwords or base64 secrets to git!
# ====================================================================

# --------------------------------------------------------------------
# 1. Database Connection Settings (MySQL 8.0 / TiDB Cloud)
# --------------------------------------------------------------------
# Localhost default: 127.0.0.1 | TiDB Cloud: gateway01.xxx.prod.aws.tidbcloud.com
DB_HOST=127.0.0.1

# Localhost default: 3306 | TiDB Cloud default: 4000
DB_PORT=3306

# Database schema name
DB_NAME=autorecon

# Database username (For TiDB Cloud, often formatted like 'xxxxxx.root')
DB_USER=autorecon_app

# Database password (MANDATORY: No hardcoded fallback)
DB_PASSWORD=your_secure_database_password_here

# --------------------------------------------------------------------
# 2. TiDB Cloud TLS / CA Certificate (Required for TiDB Cloud)
# --------------------------------------------------------------------
# Base64-encoded PEM CA certificate string.
# Generated from the CA Certificate (e.g., ISRG Root X1 / TiDB CA).
# Decoded automatically at runtime into a temporary file for PyMySQL.
# Mandatory TLS verification and hostname verification are strictly enforced.
TIDB_CA_CERT_BASE64=

# --------------------------------------------------------------------
# 3. CORS Allowed Origins (Strict No-Wildcard Policy)
# --------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Wildcard '*' is strictly prohibited for security.
# Production frontend: https://auto-recon-ai-frontend.vercel.app
CORS_ORIGINS=https://auto-recon-ai-frontend.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:8000

# --------------------------------------------------------------------
# 4. SQLAlchemy Connection Pool Settings (Optimized for Render Free)
# --------------------------------------------------------------------
# Render Free spins down after 15 minutes of inactivity (512MB RAM).
# TiDB Cloud load balancers drop idle connections after 5 minutes (300s).
# Lower pool size with 300s recycle avoids connection leaks and stale connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10

# --------------------------------------------------------------------
# 5. Storage & Port Configuration
# --------------------------------------------------------------------
AUTORECON_STORAGE_DIR=backend/storage
API_HOST=0.0.0.0
API_PORT=8000
