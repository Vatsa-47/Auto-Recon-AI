{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".venv/**",
      "backend/**",
      "spring-backend/**",
      "AUTO_RECON_REPORT_SOURCE_PACK/**",
      "AUTO_RECON_REPORT_SOURCE_PACK.zip",
      "review_ii_screenshots/**",
      "backup_*/**",
      "*.md",
      "*.py",
      "*.ps1"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  },
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "runtime": "python312",
      "ignore": [
        ".git",
        ".git/**",
        ".venv",
        ".venv/**",
        "tests",
        "tests/**",
        "**/__pycache__/**",
        "*.pyc",
        ".pytest_cache",
        ".pytest_cache/**",
        "storage/reports/**",
        "storage/datasets/**",
        "ml/data/**"
      ]
    }
  ]
}
