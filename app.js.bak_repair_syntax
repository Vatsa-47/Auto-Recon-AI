        const targetT = parseFloat(node.getAttribute('data-t'));
        let bestIdx = 0;
        let minDiff = Infinity;
        state.telemetryData.forEach((d, i) => {
          const diff = Math.abs(d.t - targetT);
          if (diff < minDiff) {
            minDiff = diff;
