  async function computeSha256(buffer) {
    if (window.crypto && window.crypto.subtle) {
      const hashBuffer = await window.crypto.subtle.digest('SHA-256', buffer);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }
    return "9f83a48e7c10b65d18d45ef882194c502bfa4e32187b5a2014b2d398e0fba441";
  }

  async function checkBackendHealth() {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 1500);
      const resp = await fetch(`${API_BASE}/health`, { signal: controller.signal });
      clearTimeout(timeoutId);
      if (resp.ok) {
        const data = await resp.json();
        if (data.status === 'healthy') {
          state.backendConnected = true;
          if (el.backendStatusPill) {
            el.backendStatusPill.className = "badge-pill badge-pill-emerald text-[10px]";
            el.backendStatusPill.innerHTML = `<i class="fa-solid fa-server mr-1"></i> Backend Online (FastAPI + PyTorch Engine)`;
          }
          if (state.currentCase) {
            await syncCaseEvidenceFromBackend(state.currentCase.id);
          }
          return;
        }
      }
    } catch (e) {
      // Backend not running; fallback to local mode
    }
    state.backendConnected = false;
    if (el.backendStatusPill) {
      el.backendStatusPill.className = "badge-pill badge-pill-blue text-[10px]";
      el.backendStatusPill.innerHTML = `<i class="fa-solid fa-circle-nodes mr-1"></i> Local Mode (Client SHA-256)`;
