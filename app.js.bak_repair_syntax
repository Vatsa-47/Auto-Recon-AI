  function drawImpactBurst(ctx, x, y, energy = 1.0) {
    const rad = 28 * energy;
    ctx.fillStyle = 'rgba(239, 68, 68, 0.85)';
    ctx.beginPath();
    ctx.arc(x, y, rad, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(x, y, rad * 0.45, 0, Math.PI * 2);
    ctx.fill();

    // Impact sparks
    ctx.strokeStyle = '#fef08a';
    ctx.lineWidth = 2;
    for (let a = 0; a < Math.PI * 2; a += Math.PI / 4) {
      ctx.beginPath();
      ctx.moveTo(x + Math.cos(a) * rad * 0.5, y + Math.sin(a) * rad * 0.5);
      ctx.lineTo(x + Math.cos(a) * rad * 1.3, y + Math.sin(a) * rad * 1.3);
      ctx.stroke();
