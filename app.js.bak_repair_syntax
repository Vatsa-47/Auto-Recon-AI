  // ==========================================
  // WHAT-IF COUNTERFACTUAL SIMULATOR
  // ==========================================
  function resetWhatIf() {
    state.whatIf.reactionDelayMs = 0;
    state.whatIf.latencyMs = 2100;
    state.whatIf.speedDelta = 0;

    if (el.whatifReactionSlider) el.whatifReactionSlider.value = 0;
    if (el.whatifReactionVal) el.whatifReactionVal.textContent = '0 ms';
    if (el.whatifLatencySlider) el.whatifLatencySlider.value = 2100;
    if (el.whatifLatencyVal) el.whatifLatencyVal.textContent = '2100 ms';
    if (el.whatifSpeedSlider) el.whatifSpeedSlider.value = 0;
    if (el.whatifSpeedVal) el.whatifSpeedVal.textContent = '0 km/h';

    runWhatIfSimulation();
  }

  function runWhatIfSimulation() {
    if (!el.whatifSimImpact || !el.whatifSimDetail) return;

    const reaction = state.whatIf.reactionDelayMs;
    const latency = state.whatIf.latencyMs;
    const speedAdjust = state.whatIf.speedDelta;

    const baseRecordedSpeed = 57.8;
    let simSpeed = baseRecordedSpeed + speedAdjust;

    // Latency reduction saves stopping distance
    const latencySavingsMs = 2100 - latency;
    const speedReductionFromLatency = (latencySavingsMs / 1000) * 14.5;
    simSpeed -= speedReductionFromLatency;

    // Earlier driver reaction saves speed
    const reactionSavingsMs = -reaction;
    const speedReductionFromReaction = (reactionSavingsMs / 1000) * 12.0;
    simSpeed -= speedReductionFromReaction;

    if (simSpeed <= 0) {
      el.whatifSimImpact.innerHTML = `<span class="text-emerald-600 font-bold">Impact: AVOIDED</span>`;
      el.whatifSimDetail.innerHTML = `Vehicle stops <strong class="text-blue-950 font-bold">3.4m</strong> prior to intersection point.`;
    } else {
      el.whatifSimImpact.innerHTML = `<span class="text-rose-600 font-bold">Impact: YES</span>`;
      el.whatifSimDetail.innerHTML = `Simulated Speed: <strong class="text-blue-950 font-bold">${Math.max(12, simSpeed).toFixed(1)} km/h</strong> (${Math.round((baseRecordedSpeed - Math.max(12, simSpeed)) / baseRecordedSpeed * 100)}% delta)`;
    }
  }

  if (el.whatifReactionSlider) {
    el.whatifReactionSlider.addEventListener('input', (e) => {
      state.whatIf.reactionDelayMs = parseInt(e.target.value);
      if (el.whatifReactionVal) el.whatifReactionVal.textContent = `${state.whatIf.reactionDelayMs >= 0 ? '+' : ''}${state.whatIf.reactionDelayMs} ms`;
      runWhatIfSimulation();
    });
  }

  if (el.whatifLatencySlider) {
    el.whatifLatencySlider.addEventListener('input', (e) => {
      state.whatIf.latencyMs = parseInt(e.target.value);
      if (el.whatifLatencyVal) el.whatifLatencyVal.textContent = `${state.whatIf.latencyMs} ms`;
      runWhatIfSimulation();
    });
  }

  if (el.whatifSpeedSlider) {
    el.whatifSpeedSlider.addEventListener('input', (e) => {
      state.whatIf.speedDelta = parseInt(e.target.value);
      if (el.whatifSpeedVal) el.whatifSpeedVal.textContent = `${state.whatIf.speedDelta >= 0 ? '+' : ''}${state.whatIf.speedDelta} km/h`;
      runWhatIfSimulation();
    });
  }

  if (el.btnResetWhatif) el.btnResetWhatif.addEventListener('click', resetWhatIf);

  // ==========================================
  // CHART.JS INTEGRATION (WHITE & BLUE EXECUTIVE FORENSIC PALETTE)
  // ==========================================
  function initTelemetryCharts() {
    if (!window.Chart || !state.telemetryData || state.telemetryData.length === 0) return;

    const labels = state.telemetryData.map(d => `${d.t >= 0 ? '+' : ''}${d.t.toFixed(1)}s`);
    const speeds = state.telemetryData.map(d => d.speed);
    const throttles = state.telemetryData.map(d => d.throttle);
    const brakes = state.telemetryData.map(d => d.brake);
    const steers = state.telemetryData.map(d => d.steer);
    const yaws = state.telemetryData.map(d => d.yaw);
    const canLoads = state.telemetryData.map(d => d.canLoad);

    const commonOptions = {
      responsive: true,
      maintainAspectRatio: false,
      animation: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { labels: { color: '#1e3a8a', font: { size: 10, family: 'Plus Jakarta Sans', weight: '600' } } },
