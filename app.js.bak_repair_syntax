  // 7. Isometric Mountain Grade / Arrester Bed
  function drawIsometricMountain(ctx, kin) {
    const cx = kin.cx;
    const cy = kin.cy;

    // 3D Mountain rocky backdrop
    draw3DBox(ctx, 400, cy - 75, 0, 800, 35, 45, 0, '#44403c', '#292524', '#1c1917');

    // Roadway
    drawIsoQuad(ctx, 0, cy - 45, 800, cy - 10, 800, cy + 45, 0, cy + 15, 0, '#1e293b');

    // 3D Gravel bed
    draw3DBox(ctx, cx + 170, cy + 50, 0, 250, 48, 8, 0, '#78716c', '#57534e', '#44403c');

    // Heavy commercial 6x4 truck
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, -0.06, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height, true);
  }

  // 3D Drawing Primitives
  function drawIsoQuad(ctx, x1, y1, x2, y2, x3, y3, x4, y4, z, fillColor) {
    const p1 = isoProj(x1, y1, z);
    const p2 = isoProj(x2, y2, z);
    const p3 = isoProj(x3, y3, z);
    const p4 = isoProj(x4, y4, z);

    ctx.fillStyle = fillColor;
    ctx.beginPath();
    ctx.moveTo(p1.x, p1.y);
    ctx.lineTo(p2.x, p2.y);
    ctx.lineTo(p3.x, p3.y);
    ctx.lineTo(p4.x, p4.y);
    ctx.closePath();
    ctx.fill();
  }

  function draw3DBox(ctx, wx, wy, wz, len, wid, height, heading, colorTop, colorSide, colorFront) {
    const cos = Math.cos(heading);
    const sin = Math.sin(heading);
    const hl = len / 2;
    const hw = wid / 2;

    const c1 = { x: wx - hl*cos + hw*sin, y: wy - hl*sin - hw*cos };
    const c2 = { x: wx + hl*cos + hw*sin, y: wy + hl*sin - hw*cos };
    const c3 = { x: wx + hl*cos - hw*sin, y: wy + hl*sin + hw*cos };
    const c4 = { x: wx - hl*cos - hw*sin, y: wy - hl*sin + hw*cos };

    // Bottom
    const b1 = isoProj(c1.x, c1.y, wz);
    const b2 = isoProj(c2.x, c2.y, wz);
    const b3 = isoProj(c3.x, c3.y, wz);
    const b4 = isoProj(c4.x, c4.y, wz);

    // Top
    const t1 = isoProj(c1.x, c1.y, wz + height);
    const t2 = isoProj(c2.x, c2.y, wz + height);
    const t3 = isoProj(c3.x, c3.y, wz + height);
    const t4 = isoProj(c4.x, c4.y, wz + height);

    // Side 1 (Right)
    ctx.fillStyle = colorSide;
    ctx.beginPath();
    ctx.moveTo(b2.x, b2.y); ctx.lineTo(b3.x, b3.y); ctx.lineTo(t3.x, t3.y); ctx.lineTo(t2.x, t2.y);
    ctx.closePath(); ctx.fill();

    // Side 2 (Front)
    ctx.fillStyle = colorFront;
    ctx.beginPath();
    ctx.moveTo(b3.x, b3.y); ctx.lineTo(b4.x, b4.y); ctx.lineTo(t4.x, t4.y); ctx.lineTo(t3.x, t3.y);
    ctx.closePath(); ctx.fill();

    // Top
    ctx.fillStyle = colorTop;
    ctx.beginPath();
    ctx.moveTo(t1.x, t1.y); ctx.lineTo(t2.x, t2.y); ctx.lineTo(t3.x, t3.y); ctx.lineTo(t4.x, t4.y);
    ctx.closePath(); ctx.fill();
  }

  function draw3DPost(ctx, wx, wy, height, color) {
    const b = isoProj(wx, wy, 0);
    const t = isoProj(wx, wy, height);
    ctx.strokeStyle = color;
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(b.x, b.y); ctx.lineTo(t.x, t.y);
    ctx.stroke();
  }

  function drawCar3D(ctx, wx, wy, wz, heading, roll, pitch, color, roofColor, label, brakeActive, len, wid, height, isTruck = false) {
    // Drop shadow
    const shp = isoProj(wx, wy, 0);
    ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
    ctx.beginPath();
    ctx.ellipse(shp.x, shp.y + 2, len * 0.45, wid * 0.35, 0, 0, Math.PI * 2);
    ctx.fill();

    // 3D Body Box
    draw3DBox(ctx, wx, wy, wz, len, wid, height, heading, roofColor, color, '#0f172a');

    // Cabin Greenhouse
    if (!isTruck) {
      draw3DBox(ctx, wx - 4, wy, wz + height, len * 0.5, wid * 0.8, height * 0.6, heading, '#38bdf8', '#0369a1', '#075985');
    } else {
      // Commercial Truck Cab + Cargo Box
      draw3DBox(ctx, wx + 12, wy, wz + height, len * 0.35, wid * 0.9, height * 0.8, heading, '#fde68a', '#d97706', '#92400e');
      draw3DBox(ctx, wx - 10, wy, wz + height, len * 0.55, wid, height * 1.1, heading, '#e2e8f0', '#94a3b8', '#64748b');
    }

    // Brake lights in 3D
    if (brakeActive) {
      const cos = Math.cos(heading);
      const sin = Math.sin(heading);
      const blX = wx - (len / 2) * cos;
      const blY = wy - (len / 2) * sin;
      const bp = isoProj(blX, blY, wz + 6);
      ctx.fillStyle = '#ef4444';
      ctx.beginPath();
      ctx.arc(bp.x, bp.y, 4, 0, Math.PI * 2);
      ctx.fill();
    }

    // Label
    if (label) {
      const lp = isoProj(wx, wy, wz + height + 16);
      ctx.fillStyle = '#cbd5e1';
      ctx.font = '10px "Plus Jakarta Sans", sans-serif';
      ctx.fillText(label, lp.x - 28, lp.y);
    }
  }

  function drawPedestrian3D(ctx, wx, wy, wz, isStruck) {
    const pBase = isoProj(wx, wy, wz);
    const pHead = isoProj(wx, wy, wz + (isStruck ? 4 : 18));
    ctx.fillStyle = '#f59e0b';
    ctx.beginPath();
    ctx.arc(pHead.x, pHead.y, 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#f59e0b';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(pBase.x, pBase.y);
    ctx.lineTo(pHead.x, pHead.y);
    ctx.stroke();
  }

  // 8. Isometric FARS Head-On
  function drawIsometricFARSHeadOn(ctx, kin) {
    const cy = kin.cy;
    drawIsoQuad(ctx, 0, cy - 50, 800, cy - 50, 800, cy + 50, 0, cy + 50, 0, '#1e293b');
    if (kin.target) {
      drawCar3D(ctx, kin.target.x, kin.target.y, 0, kin.target.heading, 0, 0, kin.target.color, kin.target.roofColor, kin.target.label, kin.target.brake, kin.target.len, kin.target.wid, kin.target.height);
    }
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, kin.ego.roll, 0, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 9. Isometric FARS Wet Angle
  function drawIsometricFARSAngle(ctx, kin) {
    const cx = kin.cx;
    const cy = kin.cy;
    const rw = 160;
    drawIsoQuad(ctx, 0, cy - rw/2, 800, cy - rw/2, 800, cy + rw/2, 0, cy + rw/2, 0, '#0f172a');
    drawIsoQuad(ctx, cx - rw/2, 0, cx + rw/2, 0, cx + rw/2, 420, cx - rw/2, 420, 0, '#0f172a');
    if (kin.target) {
      drawCar3D(ctx, kin.target.x, kin.target.y, 0, kin.target.heading, 0, 0, kin.target.color, kin.target.roofColor, kin.target.label, kin.target.brake, kin.target.len, kin.target.wid, kin.target.height);
    }
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, 0, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 10. Isometric FARS 3-Vehicle Chain
  function drawIsometricFARSChain(ctx, kin) {
    const cy = kin.cy;
    drawIsoQuad(ctx, 0, cy - 75, 800, cy - 75, 800, cy + 75, 0, cy + 75, 0, '#1e293b');
    kin.actors.forEach(act => {
      drawCar3D(ctx, act.x, act.y, 0, act.heading, 0, 0, act.color, act.roofColor, act.label, act.brake, act.len, act.wid, act.height);
    });
    if (kin.target) {
      drawCar3D(ctx, kin.target.x, kin.target.y, 0, kin.target.heading, 0, 0, kin.target.color, kin.target.roofColor, kin.target.label, kin.target.brake, kin.target.len, kin.target.wid, kin.target.height);
    }
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, 0, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 11. Isometric FARS Roadway Departure & Tree
  function drawIsometricFARSRunOff(ctx, kin) {
    const cy = kin.cy;
    const roadY = cy - 20;
    drawIsoQuad(ctx, 0, roadY - 45, 800, roadY - 45, 800, roadY + 45, 0, roadY + 45, 0, '#1e293b');
    drawIsoQuad(ctx, 0, roadY + 45, 800, roadY + 45, 800, 420, 0, 420, 0, '#14532d');
    kin.actors.forEach(act => {
      if (act.type === 'tree') {
        const pBase = isoProj(act.x, act.y, 0);
        const pTop = isoProj(act.x, act.y, 50);
        ctx.strokeStyle = '#78350f';
        ctx.lineWidth = 7;
        ctx.beginPath(); ctx.moveTo(pBase.x, pBase.y); ctx.lineTo(pTop.x, pTop.y); ctx.stroke();
        ctx.fillStyle = '#15803d';
        ctx.beginPath(); ctx.arc(pTop.x, pTop.y, 18, 0, Math.PI * 2); ctx.fill();
      }
    });
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, kin.ego.roll, 0, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 12. Isometric FARS Arterial Culvert
  function drawIsometricFARSCulvert(ctx, kin) {
    const cy = kin.cy;
    drawIsoQuad(ctx, 0, cy - 50, 800, cy - 50, 800, cy + 50, 0, cy + 50, 0, '#1e293b');
    kin.actors.forEach(act => {
      if (act.type === 'culvert') {
        draw3DBox(ctx, act.x, act.y, 0, 36, 24, 18, 0, '#64748b', '#94a3b8', '#334155');
      }
    });
    if (kin.target) {
      drawCar3D(ctx, kin.target.x, kin.target.y, 0, kin.target.heading, 0, 0, kin.target.color, kin.target.roofColor, kin.target.label, kin.target.brake, kin.target.len, kin.target.wid, kin.target.height);
    }
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, 0, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // ==========================================
  // DASHCAM VIEW (AUTHENTIC DRIVER PERSPECTIVE)
  // ==========================================
  function drawDashcamVisionView(ctx, w, h, t, item) {
    const kin = getScenarioKinematics(state.activeCaseId, t, item);
    const cx = w / 2;
    let horizonY = 175;
    let cameraRoll = kin.ego.roll || 0;

    ctx.save();
    ctx.translate(cx, horizonY);
    ctx.rotate(cameraRoll);
    ctx.translate(-cx, -horizonY);

    // Horizon Vanishing point
    const vx = cx + (kin.ego.steer * 1.5);

    // 1. Atmosphere / Sky
    drawDashcamSky(ctx, w, h, horizonY, state.activeCaseId);

    // 2. Road surface perspective
    drawDashcamRoad(ctx, w, h, horizonY, vx, state.activeCaseId);

    // 3. Scenario-specific perspective actors
    drawDashcamScenarioActors(ctx, w, h, horizonY, vx, kin);

    ctx.restore();

    // 4. High-Tech Forensic ADAS HUD Overlay
    drawDashcamHUD(ctx, w, h, t, item, kin);
  }

  function drawDashcamSky(ctx, w, h, horizonY, caseId) {
    if (caseId === 'CASE_AF_1082') {
      // Night Sky
      ctx.fillStyle = '#030712';
      ctx.fillRect(-w, -h, w * 3, h + horizonY);
      // Streetlight ambiance
      const amb = ctx.createRadialGradient(w/2, horizonY, 10, w/2, horizonY, 250);
      amb.addColorStop(0, 'rgba(254, 240, 138, 0.15)');
      amb.addColorStop(1, 'rgba(3, 7, 18, 0)');
      ctx.fillStyle = amb;
      ctx.fillRect(-w, -h, w * 3, h + horizonY);
    } else if (caseId === 'CASE_AF_MULT') {
      // Dark stormy rain sky
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(-w, -h, w * 3, h + horizonY);
      // Rain streaks
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
      ctx.lineWidth = 1;
      for (let i = 0; i < 40; i++) {
        const rx = (i * 27) % w;
        const ry = (i * 19) % horizonY;
        ctx.beginPath(); ctx.moveTo(rx, ry); ctx.lineTo(rx - 8, ry + 18); ctx.stroke();
      }
    } else if (caseId === 'FARS_2024_10009') {
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(-w, -h, w * 3, h + horizonY);
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.35)';
      ctx.lineWidth = 1.2;
      for (let i = 0; i < 50; i++) {
        const rx = (i * 29) % w;
        const ry = (i * 17) % horizonY;
        ctx.beginPath(); ctx.moveTo(rx, ry); ctx.lineTo(rx - 10, ry + 22); ctx.stroke();
      }
    } else if (caseId === 'CASE_AF_3389') {
      // Mountain grade vista
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(-w, -h, w * 3, h + horizonY);
      // Mountain ridgelines
      ctx.fillStyle = '#334155';
      ctx.beginPath();
      ctx.moveTo(-w, horizonY);
      ctx.lineTo(w * 0.2, horizonY - 45);
      ctx.lineTo(w * 0.5, horizonY - 25);
      ctx.lineTo(w * 0.85, horizonY - 60);
      ctx.lineTo(w * 2, horizonY);
      ctx.closePath();
      ctx.fill();
    } else {
      // Daylight highway / city
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(-w, -h, w * 3, h + horizonY);
    }
  }

  function drawDashcamRoad(ctx, w, h, horizonY, vx, caseId) {
    // Road pavement widening from vanishing point to bottom
    const rwNear = w * 0.88;
    const rwFar = 32;

    ctx.fillStyle = (caseId === 'CASE_AF_MULT') ? '#0b1120' : '#1e293b';
    ctx.beginPath();
    ctx.moveTo(vx - rwFar / 2, horizonY);
    ctx.lineTo(vx + rwFar / 2, horizonY);
    ctx.lineTo(w / 2 + rwNear / 2, h);
    ctx.lineTo(w / 2 - rwNear / 2, h);
    ctx.closePath();
    ctx.fill();

    // Road shoulders / curbs
    ctx.fillStyle = '#334155';
    ctx.beginPath();
    ctx.moveTo(w / 2 - rwNear / 2, h);
    ctx.lineTo(vx - rwFar / 2, horizonY);
    ctx.lineTo(vx - rwFar / 2 - 25, horizonY);
    ctx.lineTo(0, h);
    ctx.fill();

    ctx.beginPath();
    ctx.moveTo(w / 2 + rwNear / 2, h);
    ctx.lineTo(vx + rwFar / 2, horizonY);
    ctx.lineTo(vx + rwFar / 2 + 25, horizonY);
    ctx.lineTo(w, h);
    ctx.fill();

    // Center dashed lane stripes in perspective
    ctx.strokeStyle = '#eab308';
    ctx.lineWidth = 2.5;
    for (let py = horizonY + 8; py < h; py += (py - horizonY) * 0.55 + 6) {
      const segLen = (py - horizonY) * 0.35 + 8;
      const tNorm = (py - horizonY) / (h - horizonY);
      const stripeX = vx + (w/2 - vx) * tNorm;
      ctx.beginPath();
      ctx.moveTo(stripeX, py);
      ctx.lineTo(stripeX, Math.min(h, py + segLen));
      ctx.stroke();
    }

    // Outer edge lines
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(vx - rwFar / 2, horizonY); ctx.lineTo(w / 2 - rwNear / 2, h);
    ctx.moveTo(vx + rwFar / 2, horizonY); ctx.lineTo(w / 2 + rwNear / 2, h);
    ctx.stroke();
  }

  function drawDashcamScenarioActors(ctx, w, h, horizonY, vx, kin) {
    const t = kin.t;
    const cid = kin.caseId;

    // 1. Urban Intersection: Cross street & target sedan crossing
    if (cid === 'CASE_AF_8902') {
      // Crosswalk stripes in perspective
      const cwY = horizonY + 75 - t * 14;
      if (cwY > horizonY && cwY < h) {
        ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
        ctx.fillRect(w * 0.2, cwY, w * 0.6, (cwY - horizonY) * 0.12);
      }

      // Overhead Traffic Signal
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(w * 0.45, horizonY - 45, 40, 20);
      ctx.fillStyle = (t < -1.0) ? '#22c55e' : '#f59e0b';
      ctx.beginPath(); ctx.arc(w * 0.45 + 20, horizonY - 35, 6, 0, Math.PI * 2); ctx.fill();

      // Target vehicle crossing from right to left across windshield
      let vehX, vehY, vehScale;
      if (t < 0) {
        const prog = (t + 5.0) / 5.0;
        vehScale = 0.35 + prog * 0.65;
        vehX = (w * 0.75) - prog * (w * 0.35);
        vehY = horizonY + 25 + prog * 70;
      } else {
        vehScale = 1.0;
        vehX = w * 0.40;
        vehY = horizonY + 95;
      }

      if (vehY > horizonY) {
        drawPerspectiveVehicle(ctx, vehX, vehY, vehScale, '#d97706', 'TARGET SEDAN');
      }
    }

    // 2. Highway Exit / Ramp: Attenuator cushion & exit sign
    else if (cid === 'CASE_AF_4421') {
      // Overhead green exit sign
      ctx.fillStyle = '#15803d';
      ctx.fillRect(w * 0.3, horizonY - 55, 140, 26);
      ctx.strokeStyle = '#ffffff';
      ctx.strokeRect(w * 0.3, horizonY - 55, 140, 26);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 9px "JetBrains Mono", monospace';
      ctx.fillText('EXIT 14B / DOWNTOWN RAMP', w * 0.3 + 8, horizonY - 38);

      // Yellow attenuator cushion approaching
      const prog = Math.max(0, (t + 5.0) / 5.0);
      const attScale = 0.25 + prog * 0.85;
      const attY = horizonY + 15 + prog * 95;
      const attX = w * 0.52;

      ctx.fillStyle = '#eab308';
      ctx.fillRect(attX - 25 * attScale, attY, 50 * attScale, 30 * attScale);
      ctx.fillStyle = '#000000';
      for (let i = -20; i < 20; i += 8) {
        ctx.fillRect(attX + i * attScale, attY, 3 * attScale, 30 * attScale);
      }
    }

    // 3. Construction Zone: Barrels, arrow board, concrete barrier
    else if (cid === 'CASE_AF_6715') {
      // Flashing arrow board trailer on right
      const abY = horizonY + 35;
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(w * 0.72, abY - 30, 65, 36);
      ctx.strokeStyle = '#eab308';
      ctx.strokeRect(w * 0.72, abY - 30, 65, 36);
      ctx.fillStyle = '#facc15';
      ctx.font = 'bold 12px "JetBrains Mono", monospace';
      ctx.fillText('<<<', w * 0.72 + 18, abY - 8);

      // Approaching orange construction barrels
      for (let i = 0; i < 4; i++) {
        const barrelT = ((t + 5.0) / 5.0 + i * 0.2) % 1.0;
        const by = horizonY + 15 + barrelT * 110;
        const bx = w * 0.62 - (by - horizonY) * 0.25;
        const bs = (by - horizonY) * 0.02 + 0.3;
        ctx.fillStyle = '#ea580c';
        ctx.fillRect(bx, by, 16 * bs, 24 * bs);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(bx, by + 8 * bs, 16 * bs, 6 * bs);
      }
    }

    // 4. Pedestrian Crosswalk: Night headlights & walking pedestrian
    else if (cid === 'CASE_AF_1082') {
      // Headlight illumination beam on road
      const hlGrad = ctx.createRadialGradient(cx, h, 20, cx, horizonY + 30, 240);
      hlGrad.addColorStop(0, 'rgba(254, 240, 138, 0.45)');
      hlGrad.addColorStop(1, 'rgba(254, 240, 138, 0.0)');
      ctx.fillStyle = hlGrad;
      ctx.beginPath();
      ctx.moveTo(cx - 25, h);
      ctx.lineTo(cx - 140, horizonY + 35);
      ctx.lineTo(cx + 140, horizonY + 35);
      ctx.lineTo(cx + 25, h);
      ctx.fill();

      // Zebra crosswalk in headlights
      const cwY = horizonY + 65 - Math.max(0, (t + 5.0)) * 4;
      if (cwY > horizonY && cwY < h) {
        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
        ctx.fillRect(w * 0.25, cwY, w * 0.5, 12);
      }

      // Pedestrian walking across from left
      if (kin.pedestrian) {
        let pedX, pedY, pedScale;
        if (t < 0) {
          const prog = (t + 5.0) / 5.0;
          pedScale = 0.4 + prog * 0.6;
          pedX = (w * 0.25) + prog * (w * 0.24);
          pedY = horizonY + 20 + prog * 85;
        } else {
          pedScale = 1.0;
          pedX = w * 0.48;
          pedY = horizonY + 105;
        }

        // Draw pedestrian figure
        ctx.fillStyle = '#f59e0b';
        ctx.beginPath(); ctx.arc(pedX, pedY - 32 * pedScale, 6 * pedScale, 0, Math.PI * 2); ctx.fill();
        ctx.fillRect(pedX - 5 * pedScale, pedY - 26 * pedScale, 10 * pedScale, 16 * pedScale);
        ctx.strokeStyle = '#f59e0b'; ctx.lineWidth = 3 * pedScale;
        ctx.beginPath();
        ctx.moveTo(pedX - 3 * pedScale, pedY - 10 * pedScale);
        ctx.lineTo(pedX - (5 + Math.sin(t * 8) * 4) * pedScale, pedY);
        ctx.moveTo(pedX + 3 * pedScale, pedY - 10 * pedScale);
        ctx.lineTo(pedX + (5 - Math.sin(t * 8) * 4) * pedScale, pedY);
        ctx.stroke();
      }
    }

    // 5. Expressway Multi-Vehicle Pileup: Rain, wiper streaks, lead vehicle
    else if (cid === 'CASE_AF_MULT') {
      // Windshield wiper sweep arcs
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(w * 0.35, h + 50, 260, -Math.PI * 0.6, -Math.PI * 0.15); ctx.stroke();
      ctx.beginPath(); ctx.arc(w * 0.75, h + 50, 260, -Math.PI * 0.6, -Math.PI * 0.15); ctx.stroke();

      // Lead vehicle closing distance rapidly
      const prog = Math.max(0, (t + 5.0) / 5.0);
      const leadScale = 0.35 + prog * 0.75;
      const leadY = horizonY + 25 + prog * 85;
      const leadX = vx;

      drawPerspectiveVehicle(ctx, leadX, leadY, leadScale, '#475569', 'LEAD VEHICLE');

      // Glowing red taillights through rain spray
      ctx.fillStyle = '#ef4444';
      ctx.shadowColor = '#f87171';
      ctx.shadowBlur = 15;
      ctx.fillRect(leadX - 22 * leadScale, leadY - 8 * leadScale, 8 * leadScale, 6 * leadScale);
      ctx.fillRect(leadX + 14 * leadScale, leadY - 8 * leadScale, 8 * leadScale, 6 * leadScale);
      ctx.shadowBlur = 0;
    }

    // 6. Steering System Failure: Road drifting, median barrier rushing in
    else if (cid === 'CASE_AF_9104') {
      // Concrete median barrier approaching on left
      const mbProg = Math.max(0, (t + 2.5) / 2.5);
      const mbX = (w * 0.15) + (t >= -1.5 ? mbProg * 90 : 0);
      ctx.fillStyle = '#64748b';
      ctx.fillRect(0, horizonY + 10, mbX, h - horizonY);
      ctx.fillStyle = '#94a3b8';
      ctx.fillRect(mbX - 6, horizonY + 10, 6, h - horizonY);
    }

    // 7. Mountain Grade / Arrester Bed: Steep downgrade & escape ramp
    else if (cid === 'CASE_AF_3389') {
      // Runaway truck warning sign
      ctx.fillStyle = '#eab308';
      ctx.fillRect(w * 0.7, horizonY - 45, 85, 26);
      ctx.fillStyle = '#000000';
      ctx.font = 'bold 8px "JetBrains Mono", monospace';
      ctx.fillText('RUNAWAY RAMP >>>', w * 0.7 + 6, horizonY - 28);

      // Gravel bed branching right
      ctx.fillStyle = '#78716c';
      ctx.beginPath();
      ctx.moveTo(vx + 15, horizonY + 10);
      ctx.lineTo(w, horizonY + 45);
      ctx.lineTo(w, h);
      ctx.lineTo(vx + 90, h);
      ctx.fill();

      // Gravel spray when truck enters (t >= 0)
      if (t >= 0) {
        ctx.fillStyle = '#57534e';
        for (let i = 0; i < 30; i++) {
          const gx = (i * 29) % w;
          const gy = horizonY + 40 + ((i * 37) % (h - horizonY - 40));
          ctx.beginPath(); ctx.arc(gx, gy, 2.5, 0, Math.PI * 2); ctx.fill();
        }
      }
    }

    // 8. FARS #10007: Oncoming Head-On Vehicle
    else if (cid === 'FARS_2024_10007') {
      const prog = Math.max(0, (t + 5.0) / 5.0);
      const oppScale = 0.25 + prog * 1.5;
      const oppY = horizonY + 15 + prog * 85;
      const oppX = w * 0.46 + (t >= -1.2 ? ((t + 1.2) / 1.2) * (w * 0.06) : 0);
      if (oppY > horizonY && oppY < h) {
        drawPerspectiveVehicle(ctx, oppX, oppY, oppScale, '#d97706', 'ONCOMING BLAZER (12-CLOCK)');
      }
    }

    // 9. FARS #10009: Wet Roadway Broadside Angle
    else if (cid === 'FARS_2024_10009') {
      let vehX, vehY, vehScale;
      if (t < 0) {
        const prog = (t + 5.0) / 5.0;
        vehScale = 0.35 + prog * 0.7;
        vehX = (w * 0.78) - prog * (w * 0.40);
        vehY = horizonY + 20 + prog * 75;
      } else {
        vehScale = 1.05;
        vehX = w * 0.42;
        vehY = horizonY + 95;
      }
      if (vehY > horizonY) {
        drawPerspectiveVehicle(ctx, vehX, vehY, vehScale, '#d97706', 'TARGET SEDAN (WET ANGLE)');
      }
    }

    // 10. FARS #10015: 3-Vehicle Chain Reaction
    else if (cid === 'FARS_2024_10015') {
      const prog = Math.max(0, (t + 5.0) / 5.0);
      const leadScale = 0.25 + prog * 1.2;
      const leadY = horizonY + 20 + prog * 85;
      const leadX = w * 0.50;
      if (leadY > horizonY && leadY < h) {
        drawPerspectiveVehicle(ctx, leadX, leadY, leadScale, '#d97706', 'LEAD SATURN VUE');
      }
    }

    // 11. FARS #10001: Run-Off-Road Pine Tree
    else if (cid === 'FARS_2024_10001') {
      const prog = Math.max(0, (t + 5.0) / 5.0);
      const treeScale = 0.3 + prog * 1.6;
      const treeY = horizonY + 10 + prog * 80;
      const treeX = w * 0.62 + prog * 40;
      ctx.fillStyle = '#78350f';
      ctx.fillRect(treeX - 12 * treeScale, treeY, 24 * treeScale, 70 * treeScale);
      ctx.fillStyle = '#15803d';
      ctx.beginPath();
      ctx.arc(treeX, treeY - 20 * treeScale, 38 * treeScale, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#cbd5e1';
      ctx.font = 'bold 9px "JetBrains Mono", monospace';
      ctx.fillText('STAND-ALONE PINE TREE', treeX - 35, treeY - 55 * treeScale);
    }

    // 12. FARS #10022: Arterial Concrete Culvert
    else if (cid === 'FARS_2024_10022') {
      const prog = Math.max(0, (t + 5.0) / 5.0);
      const culvScale = 0.3 + prog * 1.4;
      const culvY = horizonY + 20 + prog * 80;
      const culvX = w * 0.66;
      ctx.fillStyle = '#64748b';
      ctx.fillRect(culvX - 25 * culvScale, culvY, 50 * culvScale, 28 * culvScale);
      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.arc(culvX, culvY + 14 * culvScale, 10 * culvScale, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#cbd5e1';
      ctx.font = 'bold 9px "JetBrains Mono", monospace';
      ctx.fillText('CONCRETE CULVERT HEADWALL', culvX - 45, culvY - 8);
    }
  }

