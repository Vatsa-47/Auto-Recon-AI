  function updateLiveGauges(itemOverride) {
    if (!state.telemetryData || state.telemetryData.length === 0) return;
    const d = itemOverride || getInterpolatedTelemetry(state.simTime !== undefined ? state.simTime : (state.telemetryData[state.currentIndex] ? state.telemetryData[state.currentIndex].t : -5.0));
    if (!d) return;

    if (el.gaugeSpeed) el.gaugeSpeed.textContent = `${d.speed.toFixed(1)} km/h`;
    if (el.gaugeThrottle) el.gaugeThrottle.textContent = `${(typeof d.throttle === 'number' ? d.throttle : 0).toFixed(0)}%`;
    if (el.gaugeBrake) el.gaugeBrake.textContent = `${(typeof d.brake === 'number' ? d.brake : 0).toFixed(0)} Bar`;
    if (el.gaugeSteer) el.gaugeSteer.textContent = `${d.steer >= 0 ? '+' : ''}${d.steer.toFixed(1)}°`;
    if (el.gaugeCanLoad) el.gaugeCanLoad.textContent = `${(typeof d.canLoad === 'number' ? d.canLoad : 0).toFixed(0)}%`;
    if (el.gaugeGForce) el.gaugeGForce.textContent = `${d.longG.toFixed(2)} g`;

    if (el.timeDisplay) {
      el.timeDisplay.textContent = `t = ${d.t >= 0 ? '+' : ''}${d.t.toFixed(2)}s`;
    }

    if (el.liveEventNote) {
      el.liveEventNote.innerHTML = `
        <span class="inline-block w-2.5 h-2.5 rounded-full ${d.anomaly ? 'bg-rose-500 shadow-[0_0_8px_#f43f5e]' : 'bg-sky-400 shadow-[0_0_8px_#38bdf8]'} mr-2"></span>
        <span>${d.notes || 'Cruising'}</span>
      `;
    }

    if (el.timeScrubber) {
      el.timeScrubber.value = (state.simTime !== undefined) ? state.simTime : (state.telemetryData[state.currentIndex] ? state.telemetryData[state.currentIndex].t : state.minTime || -5.0);
    }

    highlightActiveTimelineNode(d.t);
    highlightActiveRow(d.t);
    updateChartCursors();
  }

  function startPlayback() {
    state.isPlaying = true;
    updatePlayPauseButton();
    state.lastFrameTime = performance.now();
    playbackLoop(performance.now());
  }

  function pausePlayback() {
    state.isPlaying = false;
    updatePlayPauseButton();
    if (state.animationFrameId) {
      cancelAnimationFrame(state.animationFrameId);
      state.animationFrameId = null;
    }
  }

  function updatePlayPauseButton() {
    if (!el.btnPlayIcon) return;
    if (state.isPlaying) {
      el.btnPlayIcon.classList.remove('fa-play');
      el.btnPlayIcon.classList.add('fa-pause');
    } else {
      el.btnPlayIcon.classList.remove('fa-pause');
      el.btnPlayIcon.classList.add('fa-play');
    }
  }

  function playbackLoop(currentTime) {
    if (!state.isPlaying) return;

    const delta = (currentTime - state.lastFrameTime) / 1000;
    state.lastFrameTime = currentTime;

    // Advance simTime continuously
    state.simTime += delta * state.playbackSpeed;

    if (state.simTime >= state.maxTime) {
      state.simTime = state.minTime; // loop
    }

    // Also keep currentIndex roughly in sync for table highlights etc.
    let bestIdx = 0, bestDiff = Infinity;
    for (let i = 0; i < state.telemetryData.length; i++) {
      const diff = Math.abs(state.telemetryData[i].t - state.simTime);
      if (diff < bestDiff) { bestDiff = diff; bestIdx = i; }
    }
    state.currentIndex = bestIdx;

    updateLiveGauges();
    drawReconstructionFrame();

    state.animationFrameId = requestAnimationFrame(playbackLoop);
  }

  if (el.btnPlayPause) {
    el.btnPlayPause.addEventListener('click', () => {
      if (state.isPlaying) pausePlayback();
      else startPlayback();
    });
  }

  if (el.btnReset) {
    el.btnReset.addEventListener('click', () => {
      pausePlayback();
      state.currentIndex = 0;
      state.simTime = state.minTime || -5.0;
      updateLiveGauges();
      drawReconstructionFrame();
    });
  }

  if (el.btnRewind) {
    el.btnRewind.addEventListener('click', () => {
      pausePlayback();
      state.currentIndex = Math.max(0, state.currentIndex - 1);
      syncSimTimeFromIndex();
      updateLiveGauges();
      drawReconstructionFrame();
    });
  }

  if (el.btnFastForward) {
    el.btnFastForward.addEventListener('click', () => {
      pausePlayback();
      state.currentIndex = Math.min(state.telemetryData.length - 1, state.currentIndex + 1);
      updateLiveGauges();
      drawReconstructionFrame();
    });
  }

  if (el.timeScrubber) {
    el.timeScrubber.addEventListener('input', (e) => {
      pausePlayback();
      state.currentIndex = parseInt(e.target.value);
      updateLiveGauges();
      drawReconstructionFrame();
    });
  }

  if (el.speedMultiplierBtn) {
    el.speedMultiplierBtn.addEventListener('click', () => {
      if (state.playbackSpeed === 1) state.playbackSpeed = 2;
      else if (state.playbackSpeed === 2) state.playbackSpeed = 0.5;
      else state.playbackSpeed = 1;
      el.speedMultiplierBtn.textContent = `${state.playbackSpeed}x`;
    });
  }

  // Camera Switch Buttons
  if (el.cameraBtns) {
    el.cameraBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        el.cameraBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
