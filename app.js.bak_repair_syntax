    el.btnPrintReport.addEventListener('click', () => window.print());
  }

  // ==========================================
  // PITCH PRESENTATION MODAL (10 SLIDES)
  // ==========================================
  function showSlide(index) {
    state.currentSlide = Math.max(0, Math.min(state.totalSlides - 1, index));
    el.presentationSlides.forEach((slide, idx) => {
      if (idx === state.currentSlide) slide.classList.remove('hidden');
      else slide.classList.add('hidden');
    });
    if (el.slideIndicatorText) {
      el.slideIndicatorText.textContent = `Slide ${state.currentSlide + 1} / ${state.totalSlides}`;
    }
  }

  function openPresentation() {
    state.presentationActive = true;
    if (el.presentationModal) {
      el.presentationModal.classList.remove('hidden');
      el.presentationModal.classList.add('active');
    }
    if (el.btnPresentation) {
      el.btnPresentation.classList.add('bg-blue-600', 'text-white');
      el.btnPresentation.classList.remove('bg-blue-50', 'text-blue-700');
    }
    showSlide(0);
  }

  function closePresentation() {
    state.presentationActive = false;
    if (el.presentationModal) {
      el.presentationModal.classList.remove('active');
      el.presentationModal.classList.add('hidden');
    }
    if (el.btnPresentation) {
      el.btnPresentation.classList.remove('bg-blue-600', 'text-white');
      el.btnPresentation.classList.add('bg-blue-50', 'text-blue-700');
    }
  }

  if (el.btnPresentation) el.btnPresentation.addEventListener('click', openPresentation);
  if (el.btnClosePresentation) el.btnClosePresentation.addEventListener('click', closePresentation);
  if (el.btnPrevSlide) el.btnPrevSlide.addEventListener('click', () => showSlide(state.currentSlide - 1));
  if (el.btnNextSlide) el.btnNextSlide.addEventListener('click', () => showSlide(state.currentSlide + 1));

  window.addEventListener('keydown', (e) => {
    if (!state.presentationActive) return;
    if (e.key === 'ArrowRight' || e.key === 'Space') {
      e.preventDefault();
      showSlide(state.currentSlide + 1);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      showSlide(state.currentSlide - 1);
    } else if (e.key === 'Escape') {
      closePresentation();
    }
  });

  // Scenario Dropdown Change Handler
  if (el.caseSelect) {
    el.caseSelect.addEventListener('change', (e) => {
      loadCase(e.target.value);
    });
  }

  // Initial Case Load
  loadCase('CASE_AF_8902');
  checkBackendHealth();
