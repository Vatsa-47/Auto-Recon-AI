  async function syncCaseEvidenceFromBackend(caseId) {
    if (!state.backendConnected || !state.currentCase) return;
    try {
      const resp = await fetch(`${API_BASE}/cases/${encodeURIComponent(caseId)}/evidence`);
      if (resp.ok) {
        const backendItems = await resp.json();
        if (backendItems && backendItems.length > 0) {
          const formatted = backendItems.map(b => ({
            id: b.id,
            source: b.filename,
            size: (b.file_size / (1024 * 1024)).toFixed(2) + " MB",
            sha256: b.sha256,
            trusted_reference: b.trusted_reference,
            status: b.status,
            timestamp: b.uploaded_at.replace('T', ' ').substring(0, 19) + ' UTC',
            verifiedBy: b.status === 'VERIFIED' ? "FastAPI Disk Hash Match (FIPS 180-4)" : (b.status === 'MISMATCH' ? "Integrity Mismatch Detected" : "Pending Reference Input")
          }));
          
          // Merge with any pre-existing sample items that don't collide
          const existing = state.currentCase.evidenceHashes || [];
          for (const ex of existing) {
            if (!formatted.some(f => f.source === ex.source || f.sha256 === ex.sha256)) {
              formatted.push(ex);
            }
          }
          state.currentCase.evidenceHashes = formatted;
          renderChainOfCustody();
        }
      }
    } catch (e) {
      console.warn("Could not sync backend evidence:", e);
    }
  }

  async function handleFileUpload(file) {
    if (!file) return;

    const arrayBuffer = await file.arrayBuffer();
    const sha256Hex = await computeSha256(arrayBuffer);
    const sizeStr = (file.size / (1024 * 1024)).toFixed(2) + " MB";
    const refInput = el.uploadReferenceHash ? el.uploadReferenceHash.value.trim().toLowerCase() : "";
    const nowIso = new Date().toISOString();
    const currentCaseId = state.currentCase ? state.currentCase.id : "CASE_AF_01";

    let uploadEntry = null;

    if (state.backendConnected) {
      try {
        const formData = new FormData();
        formData.append("file", file);
        formData.append("case_id", currentCaseId);
        
        let evType = "GENERIC_BINARY";
        if (file.name.endsWith('.log') || file.name.endsWith('.asc')) evType = "CAN_BUS_DUMP";
        else if (file.name.endsWith('.bin')) evType = "EDR_BINARY";
        else if (file.name.endsWith('.mp4') || file.name.endsWith('.meta')) evType = "DASHCAM_VIDEO";
        else if (file.name.endsWith('.nmea') || file.name.endsWith('.csv')) evType = "TELEMETRY_DATA";
        
        formData.append("evidence_type", evType);
        formData.append("investigator_id", "Forensic_Lead_Investigator");
        if (refInput && /^[a-f0-9]{64}$/.test(refInput)) {
          formData.append("trusted_reference", refInput);
        }

        const resp = await fetch(`${API_BASE}/evidence`, {
          method: "POST",
          body: formData
        });

        if (resp.ok) {
          const bItem = await resp.json();
          uploadEntry = {
            id: bItem.id,
            source: bItem.filename,
            size: (bItem.file_size / (1024 * 1024)).toFixed(2) + " MB",
            sha256: bItem.sha256,
            trusted_reference: bItem.trusted_reference,
            status: bItem.status,
            timestamp: bItem.uploaded_at.replace('T', ' ').substring(0, 19) + ' UTC',
            verifiedBy: bItem.status === 'VERIFIED' ? "FastAPI Disk Hash Match (FIPS 180-4)" : (bItem.status === 'MISMATCH' ? "Integrity Mismatch Detected" : "Pending Reference Input")
          };
          if (el.uploadReferenceHash) el.uploadReferenceHash.value = "";
        }
      } catch (err) {
        console.error("Backend upload failed, using local mode:", err);
      }
    }

    if (!uploadEntry) {
      // Local fallback mode
      let localStatus = "UNVERIFIED";
      let verifiedBy = "No Reference Provided";
      if (refInput && /^[a-f0-9]{64}$/.test(refInput)) {
        if (sha256Hex === refInput) {
          localStatus = "VERIFIED";
          verifiedBy = "Client-side SHA-256 Match";
        } else {
          localStatus = "MISMATCH";
          verifiedBy = "Integrity Mismatch (Client-side)";
        }
      }

      const localId = `ev-local-${Date.now()}`;
      uploadEntry = {
        id: localId,
        source: file.name,
        size: sizeStr,
        sha256: sha256Hex,
        trusted_reference: (refInput && /^[a-f0-9]{64}$/.test(refInput)) ? refInput : null,
        timestamp: nowIso.replace('T', ' ').substring(0, 19) + ' UTC',
        status: localStatus,
        verifiedBy: verifiedBy
      };

      // Record in-memory audit trail
      state.localAuditTrails[localId] = [
        {
          event_id: `evt-${Date.now()}-1`,
          event_type: "INGESTION",
          timestamp: nowIso,
          actor_id: "Forensic_Examiner",
          details: `Client-side upload of ${file.name} (${sizeStr}). Initial SHA-256 computed: ${sha256Hex}`,
          verification_result: null,
          previous_hash: "0".repeat(64),
          record_hash: sha256Hex
        }
      ];

      if (refInput && /^[a-f0-9]{64}$/.test(refInput)) {
        state.localAuditTrails[localId].push({
          event_id: `evt-${Date.now()}-2`,
          event_type: "REFERENCE_ADDED",
          timestamp: nowIso,
          actor_id: "Forensic_Examiner",
          details: `Trusted reference registered: ${refInput}`,
          verification_result: null,
          previous_hash: sha256Hex,
          record_hash: sha256Hex
        });
        state.localAuditTrails[localId].push({
          event_id: `evt-${Date.now()}-3`,
          event_type: "INTEGRITY_VERIFICATION",
          timestamp: nowIso,
          actor_id: "Client_Verifier",
          details: `Hash comparison executed: ${localStatus}`,
          verification_result: localStatus,
          previous_hash: sha256Hex,
          record_hash: sha256Hex
        });
      }
      if (el.uploadReferenceHash) el.uploadReferenceHash.value = "";
    }

    if (state.currentCase && state.currentCase.evidenceHashes) {
      state.currentCase.evidenceHashes.unshift(uploadEntry);
      renderChainOfCustody();
    }

    if (file.name.endsWith('.json')) {
      try {
        const text = await file.text();
        const customCase = JSON.parse(text);
        if (customCase.id && customCase.telemetry) {
          window.FORENSIC_CASES[customCase.id] = customCase;
          const opt = document.createElement('option');
          opt.value = customCase.id;
          opt.textContent = Custom Upload: ;
          if (el.caseSelect) el.caseSelect.appendChild(opt);
          el.caseSelect.value = customCase.id;
          loadCase(customCase.id);
          switchView('studio');
        }
      } catch(e) {}
    } else if (file.name.endsWith('.csv')) {
      try {
        // Automatically fetch dataset-reconstructed scenario from backend
        const scenResp = await fetch(${API_BASE}/datasets/latest-scenario);
        if (scenResp.ok) {
          const customCase = await scenResp.json();
          if (customCase.id && customCase.telemetry) {
            window.FORENSIC_CASES[customCase.id] = customCase;
            const opt = document.createElement('option');
            opt.value = customCase.id;
            opt.textContent = Custom Upload: ;
            if (el.caseSelect) el.caseSelect.appendChild(opt);
            el.caseSelect.value = customCase.id;
            loadCase(customCase.id);
            switchView('studio');
          }
        }
      } catch(e) {
        console.warn('Could not auto-load CSV scenario:', e);
      }
    } } catch(e) {}
    }
  }

