            }, 3000);
            return;
          }
        } catch (e) {
          console.error("Batch verify failed:", e);
        }
      }

      // Local fallback
      if (state.currentCase && state.currentCase.evidenceHashes) {
        state.currentCase.evidenceHashes.forEach(h => {
          if (!h.trusted_reference) {
            h.status = "UNVERIFIED";
            h.verifiedBy = "No Reference Configured";
          } else if (h.sha256.toLowerCase() === h.trusted_reference.toLowerCase()) {
            h.status = "VERIFIED";
            h.verifiedBy = "Client-side SHA-256 Match";
          } else {
            h.status = "MISMATCH";
            h.verifiedBy = "Integrity Mismatch";
          }
        });
      }
      renderChainOfCustody();
      el.btnVerifyHashes.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600 mr-1"></i> Local Verification Complete`;
      setTimeout(() => {
