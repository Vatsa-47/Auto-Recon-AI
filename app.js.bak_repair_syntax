        x: egoX, y: egoY, heading: egoHeading, roll: 0, pitch: -0.02,
        speed: speed, brake: brake > 15, steer: steer, yaw: yaw,
        label: 'Pontiac Grand Am (Veh #1)', color: '#0284c7', roofColor: '#38bdf8',
        len: 44, wid: 20, height: 14
      };

      kin.target = {
        x: v2X, y: v2Y, heading: v2Heading,
        speed: 25, brake: true,
        label: 'Saturn Vue (Veh #2)', color: '#d97706', roofColor: '#fde68a',
        len: 44, wid: 20, height: 16
      };

      kin.actors.push({
        type: 'car', x: v3X, y: v3Y, heading: Math.PI,
        speed: 50, brake: false,
        label: 'Chevy Tahoe (Veh #3)', color: '#475569', roofColor: '#94a3b8',
        len: 50, wid: 23, height: 18
      });

      kin.impact = { active: (t >= -0.06 && t <= 0.4), x: leadX - 10, y: laneY, energy: 1.3 };

      kin.milestones = [
        { t: -2.5, label: '65 mph CLOSING VELOCITY', x: 120, y: laneY, type: 'action' },
        { t: 0.0, label: '★ 0.0s REAR-END (V1 -> V2)', x: leadX - 10, y: laneY, type: 'impact' },
        { t: 0.8, label: '★ +0.8s SECONDARY (V2 -> V3)', x: leadX + 45, y: laneY - 35, type: 'impact' }
      ];
    }

    // 11. FARS #10001: High-Speed Run-Off-Road & Tree Rollover
    else if (caseId === 'FARS_2024_10001') {
      const roadY = cy - 20;
      const treeX = cx + 85;
      const treeY = cy + 45;
      let egoX, egoY, egoHeading, egoRoll = 0;

      if (t < -1.5) {
        const preP = (t + 5.0) / 3.5;
        egoX = 60 + preP * (cx - 30 - 60);
        egoY = roadY;
        egoHeading = 0.0;
      } else if (t < 0) {
        const driftP = (t + 1.5) / 1.5;
        egoX = (cx - 30) + driftP * (treeX - 18 - (cx - 30));
        egoY = roadY + driftP * (treeY - roadY);
        egoHeading = driftP * 0.48;
      } else {
        egoX = treeX - 10 + postP * 12;
        egoY = treeY + postP * 8;
        egoHeading = 0.65;
        egoRoll = postP * Math.PI * 0.75;
      }

      kin.ego = {
        x: egoX, y: egoY, heading: egoHeading, roll: egoRoll, pitch: 0.05,
        speed: speed, brake: brake > 15, steer: steer, yaw: yaw,
        label: 'Ford F-150 Pickup (Veh #1)', color: '#0284c7', roofColor: '#38bdf8',
        len: 48, wid: 22, height: 17
      };

      kin.actors.push({
        type: 'tree',
        x: treeX, y: treeY,
        crushed: t >= 0,
        label: 'Mature Pine Tree (FARS SOE: 42)'
      });

      kin.impact = { active: (t >= -0.05 && t <= 0.5), x: treeX - 12, y: treeY, energy: 1.5 };

      if (t >= -1.5) {
        kin.skidmarks.push({ x1: cx - 25, y1: roadY + 8, x2: Math.min(treeX, egoX), y2: egoY, gravel: true });
      }

      kin.milestones = [
        { t: -2.5, label: '72 mph NEGOTIATING CURVE', x: 110, y: roadY, type: 'action' },
        { t: -1.5, label: '⚠ -1.5s ROADWAY DEPARTURE', x: cx - 25, y: roadY + 12, type: 'anomaly' },
        { t: 0.0, label: '★ 0.0s TREE IMPACT (SOE 42)', x: treeX - 12, y: treeY, type: 'impact' },
        { t: 0.8, label: '↺ +0.8s TRIP ROLLOVER (SOE 01)', x: treeX, y: treeY + 18, type: 'anomaly' }
      ];
    }

    // 12. FARS #10022: Arterial High-Speed Rear-End & Culvert Strike
    else if (caseId === 'FARS_2024_10022') {
      const roadY = cy;
      const culvertX = cx + 110;
      const culvertY = cy + 50;
      const leadX = cx - 15;
      let egoX, egoY, egoHeading;

      if (t < 0) {
        egoX = 60 + p * (leadX - 20 - 60);
        egoY = roadY;
        egoHeading = 0.0;
      } else if (t < 0.9) {
        const offP = t / 0.9;
        egoX = (leadX - 20) + offP * (culvertX - 15 - (leadX - 20));
        egoY = roadY + offP * (culvertY - roadY);
        egoHeading = offP * 0.42;
      } else {
        egoX = culvertX - 8 + (postP - 0.36) * 8;
        egoY = culvertY + (postP - 0.36) * 4;
        egoHeading = 0.52;
      }

      let tgtX, tgtY;
      if (t < 0) {
        tgtX = leadX; tgtY = roadY;
      } else {
        tgtX = leadX + postP * 45; tgtY = roadY - postP * 12;
      }

      kin.ego = {
        x: egoX, y: egoY, heading: egoHeading, roll: 0, pitch: -0.04,
        speed: speed, brake: brake > 15, steer: steer, yaw: yaw,
        label: 'Dodge Charger (Veh #1)', color: '#0284c7', roofColor: '#38bdf8',
        len: 46, wid: 21, height: 15
      };

      kin.target = {
        x: tgtX, y: tgtY, heading: 0.0,
        speed: 35, brake: true,
        label: 'Toyota Corolla (Veh #2)', color: '#d97706', roofColor: '#fde68a',
        len: 42, wid: 20, height: 14
      };

      kin.actors.push({
        type: 'culvert',
        x: culvertX, y: culvertY,
        crushed: t >= 0.9,
        label: 'Concrete Drainage Culvert (SOE: 33)'
      });

      kin.impact = { active: (t >= -0.05 && t <= 0.35), x: leadX - 8, y: roadY, energy: 1.1 };
      if (t >= 0.85 && t <= 1.3) {
        kin.impact = { active: true, x: culvertX - 8, y: culvertY, energy: 1.7 };
      }

      kin.milestones = [
        { t: -2.0, label: '82 mph HIGH SPEED CONVERGENCE', x: 120, y: roadY, type: 'action' },
        { t: 0.0, label: '★ 0.0s GLANCING REAR-END', x: leadX - 8, y: roadY, type: 'impact' },
        { t: 0.9, label: '★ +0.9s CULVERT STRIKE (SOE 33)', x: culvertX - 8, y: culvertY, type: 'impact' }
      ];
    }

    return kin;
  }

  // ==========================================
  // TOP VIEW (FORENSIC 2D PLAN RECONSTRUCTION)
  // ==========================================
  function drawTopDownPhysicsScene(ctx, w, h, t, item) {
    const kin = getScenarioKinematics(state.activeCaseId, t, item);
    const cx = w / 2;
    const cy = h / 2;

    // Dark pavement background
    ctx.fillStyle = '#0b0f19';
    ctx.fillRect(0, 0, w, h);

    // Subtle grid
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
    ctx.lineWidth = 1;
    for (let x = 0; x < w; x += 40) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
    }
    for (let y = 0; y < h; y += 40) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
    }

    if (state.activeCaseId === 'CASE_AF_8902') {
      drawTopDownIntersection(ctx, w, h, kin);
    } else if (state.activeCaseId === 'CASE_AF_4421') {
      drawTopDownHighwayRamp(ctx, w, h, kin);
    } else if (state.activeCaseId === 'CASE_AF_6715') {
      drawTopDownConstruction(ctx, w, h, kin);
    } else if (state.activeCaseId === 'CASE_AF_1082') {
      drawTopDownCrosswalk(ctx, w, h, kin);
    } else if (state.activeCaseId === 'CASE_AF_MULT') {
      drawTopDownPileup(ctx, w, h, kin);
    } else if (state.activeCaseId === 'CASE_AF_9104') {
      drawTopDownSteering(ctx, w, h, kin);
    } else if (state.activeCaseId === 'CASE_AF_3389') {
      drawTopDownMountain(ctx, w, h, kin);
    } else if (state.activeCaseId === 'FARS_2024_10007') {
      drawTopDownFARSHeadOn(ctx, w, h, kin);
    } else if (state.activeCaseId === 'FARS_2024_10009') {
      drawTopDownFARSAngle(ctx, w, h, kin);
    } else if (state.activeCaseId === 'FARS_2024_10015') {
      drawTopDownFARSChain(ctx, w, h, kin);
    } else if (state.activeCaseId === 'FARS_2024_10001') {
      drawTopDownFARSRunOff(ctx, w, h, kin);
    } else if (state.activeCaseId === 'FARS_2024_10022') {
      drawTopDownFARSCulvert(ctx, w, h, kin);
    } else {
      drawTopDownIntersection(ctx, w, h, kin);
    }

    // Common trajectory milestones
    drawMilestoneBadges2D(ctx, kin.milestones, t);

    // Common skidmarks
    drawSkidMarks2D(ctx, kin.skidmarks);

    // Impact burst
    if (kin.impact && kin.impact.active) {
      drawImpactBurst(ctx, kin.impact.x, kin.impact.y, kin.impact.energy);
    }
  }

  // 1. Urban Intersection 2D
  function drawTopDownIntersection(ctx, w, h, kin) {
    const cx = kin.cx;
    const cy = kin.cy;
    const rw = 160;

    // Asphalt intersection
    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, cy - rw / 2, w, rw);
    ctx.fillRect(cx - rw / 2, 0, rw, h);

    // Curbs & corners
    ctx.fillStyle = '#334155';
    ctx.fillRect(0, cy - rw / 2 - 8, cx - rw / 2, 8);
    ctx.fillRect(0, cy + rw / 2, cx - rw / 2, 8);
    ctx.fillRect(cx + rw / 2, cy - rw / 2 - 8, w - (cx + rw / 2), 8);
    ctx.fillRect(cx + rw / 2, cy + rw / 2, w - (cx + rw / 2), 8);

    // Crosswalk zebra stripes
    ctx.fillStyle = '#cbd5e1';
    for (let i = -rw / 2 + 10; i < rw / 2 - 10; i += 18) {
      ctx.fillRect(cx - rw / 2 - 25, cy + i, 18, 8);
      ctx.fillRect(cx + rw / 2 + 7, cy + i, 18, 8);
      ctx.fillRect(cx + i, cy - rw / 2 - 25, 8, 18);
      ctx.fillRect(cx + i, cy + rw / 2 + 7, 8, 18);
    }

    // Stop bars
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(cx - rw / 2 - 32, cy, 5, rw / 2);
    ctx.fillRect(cx, cy - rw / 2 - 32, rw / 2, 5);

    // Dual yellow centerlines
    ctx.strokeStyle = '#eab308';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, cy - 2); ctx.lineTo(cx - rw / 2 - 35, cy - 2);
    ctx.moveTo(0, cy + 2); ctx.lineTo(cx - rw / 2 - 35, cy + 2);
    ctx.moveTo(cx + rw / 2 + 35, cy - 2); ctx.lineTo(w, cy - 2);
    ctx.moveTo(cx + rw / 2 + 35, cy + 2); ctx.lineTo(w, cy + 2);
    ctx.moveTo(cx - 2, 0); ctx.lineTo(cx - 2, cy - rw / 2 - 35);
    ctx.moveTo(cx + 2, 0); ctx.lineTo(cx + 2, cy - rw / 2 - 35);
    ctx.moveTo(cx - 2, cy + rw / 2 + 35); ctx.lineTo(cx - 2, h);
    ctx.moveTo(cx + 2, cy + rw / 2 + 35); ctx.lineTo(cx + 2, h);
    ctx.stroke();

    // Reconstructed trajectory paths (dashed)
    ctx.save();
    ctx.setLineDash([5, 5]);
    ctx.strokeStyle = 'rgba(56, 189, 248, 0.4)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(70, cy + 32); ctx.lineTo(cx - 15, cy + 32); ctx.lineTo(cx + 20, cy + 68);
    ctx.stroke();

    ctx.strokeStyle = 'rgba(245, 158, 11, 0.4)';
    ctx.beginPath();
    ctx.moveTo(cx - 12, 45); ctx.lineTo(cx - 12, cy + 12); ctx.lineTo(cx + 22, cy + 38);
    ctx.stroke();
    ctx.restore();

    // Overhead traffic signals
    drawTrafficSignalGantry2D(ctx, cx, cy, rw, kin.t);

    // Vehicles
    if (kin.target) {
      drawCar2D(ctx, kin.target.x, kin.target.y, kin.target.heading, kin.target.color, kin.target.roofColor, kin.target.label, false, kin.target.len, kin.target.wid);
    }
    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 2. Highway Exit / Ramp 2D
  function drawTopDownHighwayRamp(ctx, w, h, kin) {
    const cx = kin.cx;
    const cy = kin.cy;

    // Main carriageway
    ctx.fillStyle = '#1e293b';
    ctx.beginPath();
    ctx.moveTo(0, cy - 65);
    ctx.lineTo(w, cy - 65);
    ctx.lineTo(w, cy + 50);
    ctx.lineTo(0, cy + 50);
    ctx.fill();

    // Exit ramp diverging right
    ctx.fillStyle = '#1e293b';
    ctx.beginPath();
    ctx.moveTo(180, cy + 50);
    ctx.quadraticCurveTo(cx, cy + 60, w, cy + 120);
    ctx.lineTo(w, cy + 50);
    ctx.closePath();
    ctx.fill();

    // Painted gore chevron area
    ctx.save();
    ctx.fillStyle = '#0f172a';
    ctx.beginPath();
    ctx.moveTo(cx - 60, cy + 10);
    ctx.lineTo(cx + 110, cy - 4);
    ctx.lineTo(w, cy + 42);
    ctx.lineTo(w, cy + 10);
    ctx.closePath();
    ctx.fill();

    // Chevrons inside gore area
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2.5;
    for (let gx = cx - 40; gx < cx + 100; gx += 20) {
      ctx.beginPath();
      ctx.moveTo(gx, cy + 14);
      ctx.lineTo(gx + 12, cy + 3);
      ctx.stroke();
    }
    ctx.restore();

    // Mainline dashed lane markings
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.setLineDash([15, 15]);
    ctx.beginPath();
    ctx.moveTo(0, cy - 10); ctx.lineTo(w, cy - 10);
    ctx.stroke();
    ctx.setLineDash([]);

    // Outer solid white lines
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, cy - 65); ctx.lineTo(w, cy - 65);
    ctx.moveTo(0, cy + 50); ctx.lineTo(180, cy + 50);
    ctx.stroke();

    // Attenuator cushion at gore apex
    const attX = cx + 110;
    const attY = cy - 4;
    const isCrushed = kin.t >= 0;
    ctx.fillStyle = '#eab308';
    ctx.fillRect(attX, attY - 10, isCrushed ? 18 : 36, 20);
    ctx.fillStyle = '#000000';
    for (let bx = attX + 4; bx < attX + (isCrushed ? 16 : 34); bx += 7) {
      ctx.fillRect(bx, attY - 10, 3, 20);
    }
    ctx.fillStyle = '#cbd5e1';
    ctx.font = '9px "JetBrains Mono", monospace';
    ctx.fillText('CRASH CUSHION', attX - 10, attY - 14);

    // Trajectory path
    ctx.save();
    ctx.setLineDash([5, 5]);
    ctx.strokeStyle = 'rgba(239, 68, 68, 0.5)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(75, cy + 22);
    ctx.lineTo(attX, attY);
    ctx.stroke();
    ctx.restore();

    // Subject vehicle
    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 3. Construction Zone 2D
  function drawTopDownConstruction(ctx, w, h, kin) {
    const cx = kin.cx;
    const cy = kin.cy;

    // Highway roadway
    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, cy - 75, w, 150);

    // Closed work area shoulder
    ctx.fillStyle = 'rgba(249, 115, 22, 0.12)';
    ctx.fillRect(180, cy - 75, w - 180, 52);

    // Jersey barrier wall along closed lane
    ctx.fillStyle = '#64748b';
    ctx.fillRect(380, cy - 26, w - 380, 10);
    ctx.fillStyle = '#94a3b8';
    ctx.fillRect(380, cy - 25, w - 380, 3);

    // Lane taper barrels
    for (let i = 0; i <= 8; i++) {
      const bx = 180 + (i / 8) * 200;
      const by = (cy - 20) + (i / 8) * 35;
      ctx.fillStyle = '#ea580c';
      ctx.beginPath(); ctx.arc(bx, by, 6, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.beginPath(); ctx.arc(bx, by, 3, 0, Math.PI * 2); ctx.fill();
    }

    // Work zone barrels along barrier
    for (let bx = 390; bx < w; bx += 45) {
      ctx.fillStyle = '#ea580c';
      ctx.beginPath(); ctx.arc(bx, cy - 35, 5, 0, Math.PI * 2); ctx.fill();
    }

    // Flashing Arrow Board Trailer
    const ax = 230, ay = cy - 50;
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(ax - 20, ay - 14, 40, 26);
    ctx.strokeStyle = '#eab308';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(ax - 20, ay - 14, 40, 26);

    // Flashing yellow chevrons
    const flash = Math.floor(Date.now() / 350) % 2 === 0;
    ctx.fillStyle = flash ? '#facc15' : '#713f12';
    ctx.font = 'bold 12px "JetBrains Mono", monospace';
    ctx.fillText('<<<', ax - 14, ay + 4);

    // Dashed road lines for open lanes
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.setLineDash([15, 15]);
    ctx.beginPath();
    ctx.moveTo(0, cy + 25); ctx.lineTo(w, cy + 25);
    ctx.stroke();
    ctx.setLineDash([]);

    // Temporary yellow diverted lane markings
    ctx.strokeStyle = '#eab308';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(140, cy + 2);
    ctx.quadraticCurveTo(280, cy + 12, w, cy + 35);
    ctx.stroke();

    // Vehicle
    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#a855f7');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 4. Pedestrian Crosswalk 2D
  function drawTopDownCrosswalk(ctx, w, h, kin) {
    const cx = kin.cx;
    const cy = kin.cy;
    const roadTop = cy - 55;
    const roadBottom = cy + 55;
    const crosswalkX = cx + 20;

    // Road pavement
    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, roadTop, w, roadBottom - roadTop);

    // Sidewalks
    ctx.fillStyle = '#334155';
    ctx.fillRect(0, roadTop - 24, w, 24);
    ctx.fillRect(0, roadBottom, w, 24);

    // Curbs
    ctx.fillStyle = '#475569';
    ctx.fillRect(0, roadTop - 2, w, 3);
    ctx.fillRect(0, roadBottom, w, 3);

    // Streetlights
    drawStreetlight2D(ctx, cx - 110, roadTop - 12);
    drawStreetlight2D(ctx, cx + 150, roadTop - 12);

    // Zebra Crosswalk stripes
    ctx.fillStyle = '#f8fafc';
    for (let sy = roadTop + 6; sy < roadBottom - 6; sy += 16) {
      ctx.fillRect(crosswalkX - 16, sy, 32, 9);
    }

    // Dual yellow centerlines
    ctx.strokeStyle = '#eab308';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, cy - 2); ctx.lineTo(crosswalkX - 25, cy - 2);
    ctx.moveTo(crosswalkX + 25, cy - 2); ctx.lineTo(w, cy - 2);
    ctx.stroke();

    // Headlight cone on road for subject vehicle
    ctx.save();
    ctx.translate(kin.ego.x, kin.ego.y);
    const grad = ctx.createRadialGradient(25, 0, 5, 120, 0, 140);
    grad.addColorStop(0, 'rgba(254, 240, 138, 0.45)');
    grad.addColorStop(1, 'rgba(254, 240, 138, 0.0)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.moveTo(20, -8);
    ctx.lineTo(160, -45);
    ctx.lineTo(160, 45);
    ctx.lineTo(20, 8);
    ctx.closePath();
    ctx.fill();
    ctx.restore();

    // Pedestrian
    if (kin.pedestrian) {
      drawPedestrian2D(ctx, kin.pedestrian.x, kin.pedestrian.y, kin.pedestrian.heading, kin.pedestrian.walkCycle, kin.pedestrian.isStruck);
    }

    // Vehicle
    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 5. Expressway Multi-Vehicle Pileup 2D
  function drawTopDownPileup(ctx, w, h, kin) {
    const cy = kin.cy;

    // Wet asphalt pavement
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(0, cy - 80, w, 160);

    // Wet sheen water reflection
    ctx.fillStyle = 'rgba(56, 189, 248, 0.08)';
    ctx.fillRect(0, cy - 60, w, 120);

    // Dashed lane stripes
    ctx.strokeStyle = '#94a3b8';
    ctx.lineWidth = 2;
    ctx.setLineDash([15, 15]);
    ctx.beginPath();
    ctx.moveTo(0, cy - 30); ctx.lineTo(w, cy - 30);
    ctx.moveTo(0, cy + 25); ctx.lineTo(w, cy + 25);
    ctx.stroke();
    ctx.setLineDash([]);

    // Solid outer lines
    ctx.strokeStyle = '#f8fafc';
    ctx.beginPath();
    ctx.moveTo(0, cy - 80); ctx.lineTo(w, cy - 80);
    ctx.moveTo(0, cy + 80); ctx.lineTo(w, cy + 80);
    ctx.stroke();

    // Secondary actor vehicles
    kin.actors.forEach(act => {
      drawCar2D(ctx, act.x, act.y, act.heading, act.color, act.roofColor, act.label, act.brake, act.len, act.wid, act.hazard);
    });

    // Subject vehicle
    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 6. Steering System Failure 2D
  function drawTopDownSteering(ctx, w, h, kin) {
    const cx = kin.cx;
    const cy = kin.cy;

    // Divided highway
    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, cy - 70, w, 140);

    // Concrete median barrier along top edge
    ctx.fillStyle = '#64748b';
    ctx.fillRect(0, cy - 70, w, 14);
    ctx.fillStyle = '#94a3b8';
    ctx.fillRect(0, cy - 69, w, 4);

    // Lane dashes
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.setLineDash([15, 15]);
    ctx.beginPath();
    ctx.moveTo(0, cy - 5); ctx.lineTo(w, cy - 5);
    ctx.moveTo(0, cy + 40); ctx.lineTo(w, cy + 40);
    ctx.stroke();
    ctx.setLineDash([]);

    // Intended path (straight dashed cyan guideline)
    ctx.save();
    ctx.setLineDash([6, 6]);
    ctx.strokeStyle = 'rgba(56, 189, 248, 0.5)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(60, cy + 18); ctx.lineTo(w - 60, cy + 18);
    ctx.stroke();
    ctx.restore();
    ctx.fillStyle = '#38bdf8';
    ctx.font = '9px "JetBrains Mono", monospace';
    ctx.fillText('INTENDED PATH (CENTER LANE)', 80, cy + 32);

    // Actual path (diverging red curve)
    ctx.save();
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = 'rgba(244, 63, 94, 0.6)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(65, cy + 18);
    ctx.quadraticCurveTo(280, cy + 15, cx + 65, cy - 48);
    ctx.stroke();
    ctx.restore();

    // Vehicle
    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, false, kin.ego.roll);
  }

  // 7. Mountain Grade / Arrester Bed 2D
  function drawTopDownMountain(ctx, w, h, kin) {
    const cx = kin.cx;
    const cy = kin.cy;

    // Mountain terrain rocky backdrop on top
    ctx.fillStyle = '#292524';
    ctx.beginPath();
    ctx.moveTo(0, cy - 90);
    ctx.lineTo(w, cy - 90);
    ctx.lineTo(w, cy - 45);
    ctx.lineTo(0, cy - 45);
    ctx.fill();

    // Mountain rock facets
    ctx.fillStyle = '#44403c';
    for (let rx = 10; rx < w; rx += 70) {
      ctx.beginPath();
      ctx.moveTo(rx, cy - 45);
      ctx.lineTo(rx + 35, cy - 80);
      ctx.lineTo(rx + 70, cy - 45);
      ctx.fill();
    }

    // Curved mountain road pavement
    ctx.fillStyle = '#1e293b';
    ctx.beginPath();
    ctx.moveTo(0, cy - 45);
    ctx.quadraticCurveTo(cx - 50, cy - 35, w, cy - 10);
    ctx.lineTo(w, cy + 45);
    ctx.quadraticCurveTo(cx - 50, cy + 25, 0, cy + 15);
    ctx.fill();

    // Runaway truck escape ramp branching right
    ctx.fillStyle = '#1e293b';
    ctx.beginPath();
    ctx.moveTo(cx - 50, cy + 8);
    ctx.lineTo(cx + 45, cy + 28);
    ctx.lineTo(w - 20, cy + 45);
    ctx.lineTo(w - 20, cy + 85);
    ctx.lineTo(cx + 35, cy + 72);
    ctx.closePath();
    ctx.fill();

    // Deep loose pea-gravel bed
    ctx.fillStyle = '#78716c';
    ctx.fillRect(cx + 45, cy + 26, 250, 48);

    // Gravel aggregate texture & tire ruts
    ctx.fillStyle = '#57534e';
    for (let gx = cx + 55; gx < cx + 280; gx += 16) {
      for (let gy = cy + 32; gy < cy + 68; gy += 12) {
        ctx.fillRect(gx + (gy % 4), gy, 4, 3);
      }
    }
    if (kin.t >= 0) {
      ctx.strokeStyle = '#292524';
      ctx.lineWidth = 6;
      ctx.beginPath();
      ctx.moveTo(cx + 45, cy + 42); ctx.lineTo(kin.ego.x, cy + 42);
      ctx.moveTo(cx + 45, cy + 58); ctx.lineTo(kin.ego.x, cy + 58);
      ctx.stroke();
    }

    // Roadside steel guardrails on outer drop-off
    ctx.strokeStyle = '#94a3b8';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(0, cy + 18);
    ctx.quadraticCurveTo(cx - 50, cy + 28, cx - 50, cy + 30);
    ctx.stroke();

    // Escape ramp warning chevron sign
    ctx.fillStyle = '#facc15';
    ctx.fillRect(cx - 55, cy + 38, 22, 16);
    ctx.fillStyle = '#000000';
    ctx.font = 'bold 9px "JetBrains Mono", monospace';
    ctx.fillText('>>>', cx - 52, cy + 50);

    // Vehicle (Mammoth 6x4 Heavy Commercial Truck)
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 8. FARS Head-On Collision & Rollover 2D
  function drawTopDownFARSHeadOn(ctx, w, h, kin) {
    const cy = kin.cy;
    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, cy - 50, w, 100);

    ctx.strokeStyle = '#eab308';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, cy - 2); ctx.lineTo(w, cy - 2);
    ctx.moveTo(0, cy + 2); ctx.lineTo(w, cy + 2);
    ctx.stroke();

    ctx.strokeStyle = '#f8fafc';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, cy - 50); ctx.lineTo(w, cy - 50);
    ctx.moveTo(0, cy + 50); ctx.lineTo(w, cy + 50);
    ctx.stroke();

    if (kin.target) {
      drawCar2D(ctx, kin.target.x, kin.target.y, kin.target.heading, kin.target.color, kin.target.roofColor, kin.target.label, kin.target.brake, kin.target.len, kin.target.wid);
    }
    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 9. FARS Angle Collision (Wet Intersection) 2D
  function drawTopDownFARSAngle(ctx, w, h, kin) {
    const cx = kin.cx;
    const cy = kin.cy;
    const rw = 160;

    ctx.fillStyle = '#0f172a';
    ctx.fillRect(0, cy - rw / 2, w, rw);
    ctx.fillRect(cx - rw / 2, 0, rw, h);

    ctx.fillStyle = 'rgba(56, 189, 248, 0.08)';
    ctx.fillRect(0, cy - rw / 2, w, rw);

    ctx.strokeStyle = '#eab308';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, cy); ctx.lineTo(cx - rw / 2, cy);
    ctx.moveTo(cx + rw / 2, cy); ctx.lineTo(w, cy);
    ctx.moveTo(cx, 0); ctx.lineTo(cx, cy - rw / 2);
    ctx.moveTo(cx, cy + rw / 2); ctx.lineTo(cx, h);
    ctx.stroke();

    if (kin.target) {
      drawCar2D(ctx, kin.target.x, kin.target.y, kin.target.heading, kin.target.color, kin.target.roofColor, kin.target.label, kin.target.brake, kin.target.len, kin.target.wid);
    }
    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 10. FARS 3-Vehicle Chain Reaction 2D
  function drawTopDownFARSChain(ctx, w, h, kin) {
    const cy = kin.cy;
    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, cy - 75, w, 150);

    ctx.strokeStyle = '#94a3b8';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([15, 15]);
    ctx.beginPath();
    ctx.moveTo(0, cy - 25); ctx.lineTo(w, cy - 25);
    ctx.moveTo(0, cy + 25); ctx.lineTo(w, cy + 25);
    ctx.stroke();
    ctx.setLineDash([]);

    kin.actors.forEach(act => {
      drawCar2D(ctx, act.x, act.y, act.heading, act.color, act.roofColor, act.label, act.brake, act.len, act.wid);
    });

    if (kin.target) {
      drawCar2D(ctx, kin.target.x, kin.target.y, kin.target.heading, kin.target.color, kin.target.roofColor, kin.target.label, kin.target.brake, kin.target.len, kin.target.wid);
    }

    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 11. FARS Roadway Departure & Tree Rollover 2D
  function drawTopDownFARSRunOff(ctx, w, h, kin) {
    const cy = kin.cy;
    const roadY = cy - 20;

    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, roadY - 45, w, 90);

    ctx.strokeStyle = '#eab308';
    ctx.lineWidth = 2;
    ctx.setLineDash([12, 12]);
    ctx.beginPath();
    ctx.moveTo(0, roadY); ctx.lineTo(w, roadY);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = '#14532d';
    ctx.fillRect(0, roadY + 45, w, h - (roadY + 45));

    kin.actors.forEach(act => {
      if (act.type === 'tree') {
        ctx.fillStyle = '#78350f';
        ctx.beginPath(); ctx.arc(act.x, act.y, 9, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#15803d';
        ctx.beginPath(); ctx.arc(act.x, act.y, 22, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#f8fafc';
        ctx.font = 'bold 9px "JetBrains Mono", monospace';
        ctx.fillText('PINE TREE (FARS SOE: 42)', act.x - 45, act.y + 35);
      }
    });

    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // 12. FARS Arterial Rear-End & Culvert Strike 2D
  function drawTopDownFARSCulvert(ctx, w, h, kin) {
    const cy = kin.cy;

    ctx.fillStyle = '#1e293b';
    ctx.fillRect(0, cy - 50, w, 100);

    ctx.strokeStyle = '#f8fafc';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([12, 12]);
    ctx.beginPath();
    ctx.moveTo(0, cy); ctx.lineTo(w, cy);
    ctx.stroke();
    ctx.setLineDash([]);

    kin.actors.forEach(act => {
      if (act.type === 'culvert') {
        ctx.fillStyle = '#64748b';
        ctx.fillRect(act.x - 18, act.y - 12, 36, 24);
        ctx.fillStyle = '#0f172a';
        ctx.beginPath(); ctx.arc(act.x, act.y, 7, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#f8fafc';
        ctx.font = 'bold 9px "JetBrains Mono", monospace';
        ctx.fillText('CONCRETE CULVERT (SOE: 33)', act.x - 55, act.y + 24);
      }
    });

    if (kin.target) {
      drawCar2D(ctx, kin.target.x, kin.target.y, kin.target.heading, kin.target.color, kin.target.roofColor, kin.target.label, kin.target.brake, kin.target.len, kin.target.wid);
    }

    drawSensorRadarCone(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.item.anomaly ? '#f43f5e' : '#38bdf8');
    drawCar2D(ctx, kin.ego.x, kin.ego.y, kin.ego.heading, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid);
  }

  // ==========================================
  // 3D / ISOMETRIC ENGINE (AXONOMETRIC 2.5D)
  // ==========================================
  function isoProj(wx, wy, wz = 0) {
    const dx = wx - 400;
    const dy = wy - 210;
    const sx = 400 + (dx * 0.82) - (dy * 0.38);
    const sy = 210 + (dx * 0.22) + (dy * 0.60) - (wz * 0.85);
    return { x: sx, y: sy };
  }

  function drawIsometricView(ctx, w, h, t, item) {
    const kin = getScenarioKinematics(state.activeCaseId, t, item);

    // Deep isometric horizon & ground plane
    ctx.fillStyle = '#090d16';
    ctx.fillRect(0, 0, w, h);

    // Ground plane grid
    ctx.strokeStyle = 'rgba(56, 189, 248, 0.05)';
    ctx.lineWidth = 1;
    for (let gx = 50; gx <= 750; gx += 70) {
      const p1 = isoProj(gx, 50, 0);
      const p2 = isoProj(gx, 370, 0);
      ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
    }
    for (let gy = 50; gy <= 370; gy += 45) {
      const p1 = isoProj(50, gy, 0);
      const p2 = isoProj(750, gy, 0);
      ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
    }

    if (state.activeCaseId === 'CASE_AF_8902') {
      drawIsometricIntersection(ctx, kin);
    } else if (state.activeCaseId === 'CASE_AF_4421') {
      drawIsometricHighwayRamp(ctx, kin);
    } else if (state.activeCaseId === 'CASE_AF_6715') {
      drawIsometricConstruction(ctx, kin);
    } else if (state.activeCaseId === 'CASE_AF_1082') {
      drawIsometricCrosswalk(ctx, kin);
    } else if (state.activeCaseId === 'CASE_AF_MULT') {
      drawIsometricPileup(ctx, kin);
    } else if (state.activeCaseId === 'CASE_AF_9104') {
      drawIsometricSteering(ctx, kin);
    } else if (state.activeCaseId === 'CASE_AF_3389') {
      drawIsometricMountain(ctx, kin);
    } else if (state.activeCaseId === 'FARS_2024_10007') {
      drawIsometricFARSHeadOn(ctx, kin);
    } else if (state.activeCaseId === 'FARS_2024_10009') {
      drawIsometricFARSAngle(ctx, kin);
    } else if (state.activeCaseId === 'FARS_2024_10015') {
      drawIsometricFARSChain(ctx, kin);
    } else if (state.activeCaseId === 'FARS_2024_10001') {
      drawIsometricFARSRunOff(ctx, kin);
    } else if (state.activeCaseId === 'FARS_2024_10022') {
      drawIsometricFARSCulvert(ctx, kin);
    } else {
      drawIsometricIntersection(ctx, kin);
    }

    // 3D Impact Burst
    if (kin.impact && kin.impact.active) {
      const ip = isoProj(kin.impact.x, kin.impact.y, 8);
      drawImpactBurst(ctx, ip.x, ip.y, kin.impact.energy);
    }
  }

  // 1. Isometric Intersection
  function drawIsometricIntersection(ctx, kin) {
    const cx = kin.cx;
    const cy = kin.cy;
    const rw = 160;

    // Road surfaces
    drawIsoQuad(ctx, 0, cy - rw/2, 800, cy - rw/2, 800, cy + rw/2, 0, cy + rw/2, 0, '#1e293b');
    drawIsoQuad(ctx, cx - rw/2, 0, cx + rw/2, 0, cx + rw/2, 420, cx - rw/2, 420, 0, '#1e293b');

    // Crosswalks in 3D
    ctx.fillStyle = '#cbd5e1';
    for (let i = -rw/2 + 10; i < rw/2 - 10; i += 20) {
      drawIsoQuad(ctx, cx - rw/2 - 22, cy + i, cx - rw/2 - 6, cy + i, cx - rw/2 - 6, cy + i + 8, cx - rw/2 - 22, cy + i + 8, 0, '#cbd5e1');
      drawIsoQuad(ctx, cx + i, cy - rw/2 - 22, cx + i + 8, cy - rw/2 - 22, cx + i + 8, cy - rw/2 - 6, cx + i, cy - rw/2 - 6, 0, '#cbd5e1');
    }

    // 3D traffic light gantry
    draw3DPost(ctx, cx - rw/2 - 30, cy - rw/2 - 30, 45, '#64748b');
    draw3DPost(ctx, cx + rw/2 + 30, cy + rw/2 + 30, 45, '#64748b');

    // Vehicles
    if (kin.target) {
      drawCar3D(ctx, kin.target.x, kin.target.y, 0, kin.target.heading, 0, 0, kin.target.color, kin.target.roofColor, kin.target.label, false, kin.target.len, kin.target.wid, kin.target.height);
    }
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, kin.ego.pitch, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 2. Isometric Highway Ramp
  function drawIsometricHighwayRamp(ctx, kin) {
    const cx = kin.cx;
    const cy = kin.cy;

    // Main road plane
    drawIsoQuad(ctx, 0, cy - 65, 800, cy - 65, 800, cy + 50, 0, cy + 50, 0, '#1e293b');
    // Exit ramp plane
    drawIsoQuad(ctx, 180, cy + 50, 800, cy + 120, 800, cy + 50, 180, cy + 50, 0, '#1e293b');

    // 3D crash cushion structure at gore apex
    const attX = cx + 110;
    const attY = cy - 4;
    const isCrushed = kin.t >= 0;
    draw3DBox(ctx, attX, attY, 0, isCrushed ? 18 : 36, 18, 14, 0, '#eab308', '#ca8a04', '#000000');

    // Subject vehicle accelerating
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, -0.04, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 3. Isometric Construction Zone
  function drawIsometricConstruction(ctx, kin) {
    const cx = kin.cx;
    const cy = kin.cy;

    // Roadway
    drawIsoQuad(ctx, 0, cy - 75, 800, cy - 75, 800, cy + 75, 0, cy + 75, 0, '#1e293b');

    // 3D Concrete Jersey barrier wall
    draw3DBox(ctx, 580, cy - 26, 0, 380, 8, 14, 0, '#94a3b8', '#64748b', '#475569');

    // 3D Construction Cones / Barrels
    for (let i = 0; i <= 6; i++) {
      const bx = 180 + (i / 6) * 200;
      const by = (cy - 20) + (i / 6) * 35;
      draw3DPost(ctx, bx, by, 12, '#ea580c');
    }

    // 3D Flashing Arrow Board
    draw3DBox(ctx, 230, cy - 50, 0, 24, 8, 28, 0, '#0f172a', '#eab308', '#facc15');

    // Vehicle
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, 0, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 4. Isometric Pedestrian Crosswalk
  function drawIsometricCrosswalk(ctx, kin) {
    const cx = kin.cx;
    const cy = kin.cy;
    const crosswalkX = cx + 20;

    // Roadway
    drawIsoQuad(ctx, 0, cy - 55, 800, cy - 55, 800, cy + 55, 0, cy + 55, 0, '#1e293b');

    // Raised sidewalks in 3D
    draw3DBox(ctx, 400, cy - 67, 0, 800, 22, 6, 0, '#475569', '#334155', '#1e293b');
    draw3DBox(ctx, 400, cy + 67, 0, 800, 22, 6, 0, '#475569', '#334155', '#1e293b');

    // Crosswalk stripes in 3D
    for (let sy = cy - 45; sy < cy + 45; sy += 18) {
      drawIsoQuad(ctx, crosswalkX - 16, sy, crosswalkX + 16, sy, crosswalkX + 16, sy + 8, crosswalkX - 16, sy + 8, 0.5, '#f8fafc');
    }

    // 3D Streetlights
    draw3DPost(ctx, cx - 110, cy - 70, 48, '#94a3b8');
    draw3DPost(ctx, cx + 150, cy - 70, 48, '#94a3b8');

    // 3D Pedestrian figure
    if (kin.pedestrian) {
      drawPedestrian3D(ctx, kin.pedestrian.x, kin.pedestrian.y, 0, kin.pedestrian.isStruck);
    }

    // Vehicle
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, kin.ego.pitch, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 5. Isometric Multi-Vehicle Pileup
  function drawIsometricPileup(ctx, kin) {
    const cy = kin.cy;

    // 3-lane wet road
    drawIsoQuad(ctx, 0, cy - 80, 800, cy - 80, 800, cy + 80, 0, cy + 80, 0, '#0f172a');

    // 3D Secondary vehicles
    kin.actors.forEach(act => {
      drawCar3D(ctx, act.x, act.y, 0, act.heading, 0, 0, act.color, act.roofColor, act.label, act.brake, act.len, act.wid, act.height);
    });

    // Subject vehicle
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, 0, 0, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
  }

  // 6. Isometric Steering System Failure
  function drawIsometricSteering(ctx, kin) {
    const cy = kin.cy;

    // Highway
    drawIsoQuad(ctx, 0, cy - 70, 800, cy - 70, 800, cy + 70, 0, cy + 70, 0, '#1e293b');

    // 3D Concrete Median Barrier
    draw3DBox(ctx, 400, cy - 64, 0, 800, 10, 14, 0, '#94a3b8', '#64748b', '#475569');

    // Subject vehicle with 3D banking / rollover angle
    drawCar3D(ctx, kin.ego.x, kin.ego.y, 0, kin.ego.heading, kin.ego.roll, 0, kin.ego.color, kin.ego.roofColor, kin.ego.label, kin.ego.brake, kin.ego.len, kin.ego.wid, kin.ego.height);
