  // Window-level helpers for dynamic click handlers
  window.promptSetReference = async function(key) {
    const item = findEvidenceItem(key);
    if (!item) return;

    const ref = prompt("Enter 64-character hexadecimal SHA-256 reference hash:", item.trusted_reference || "");
    if (!ref) return;

    const cleanRef = ref.trim().toLowerCase();
    if (!/^[a-f0-9]{64}$/.test(cleanRef)) {
      alert("Invalid hash format! A SHA-256 hash must be exactly 64 hexadecimal characters.");
      return;
    }

    if (state.backendConnected && item.id && !item.id.startsWith("ev-local-")) {
      try {
        const resp = await fetch(`${API_BASE}/evidence/${item.id}/reference`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reference_hash: cleanRef, actor_id: "Forensic_Investigator" })
        });
        if (resp.ok) {
          const updated = await resp.json();
          item.trusted_reference = updated.trusted_reference;
          item.status = updated.status;
          item.verifiedBy = updated.status === 'VERIFIED' ? "FastAPI Disk Hash Match (FIPS 180-4)" : "Integrity Mismatch Detected";
          renderChainOfCustody();
          return;
        }
      } catch (e) {
        console.error("Backend reference update failed:", e);
      }
    }

    // Local fallback
    item.trusted_reference = cleanRef;
    if (item.sha256.toLowerCase() === cleanRef) {
      item.status = "VERIFIED";
      item.verifiedBy = "Client-side SHA-256 Match";
    } else {
      item.status = "MISMATCH";
      item.verifiedBy = "Integrity Mismatch (Client-side)";
    }

    if (!state.localAuditTrails[key]) state.localAuditTrails[key] = [];
    state.localAuditTrails[key].push({
      event_id: `evt-${Date.now()}`,
      event_type: "REFERENCE_ADDED",
      timestamp: new Date().toISOString(),
      actor_id: "Forensic_Investigator",
      details: `Trusted reference registered: ${cleanRef}`,
      verification_result: null,
      previous_hash: item.sha256,
      record_hash: cleanRef
    });
    renderChainOfCustody();
  };

  window.verifySingleEvidence = async function(key) {
    const item = findEvidenceItem(key);
    if (!item) return;

    if (state.backendConnected && item.id && !item.id.startsWith("ev-local-")) {
      try {
        const resp = await fetch(`${API_BASE}/evidence/${item.id}/verify`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ actor_id: "Forensic_Investigator" })
        });
        if (resp.ok) {
          const res = await resp.json();
          item.status = res.status;
          item.verifiedBy = res.status === 'VERIFIED' ? "FastAPI Disk Hash Match (FIPS 180-4)" : (res.status === 'MISMATCH' ? "Integrity Mismatch Detected" : (res.status === 'ERROR' ? "Disk Storage Error" : "Pending Reference"));
          renderChainOfCustody();
          alert(`Verification Result for ${item.source}:\nStatus: ${res.status}\nMessage: ${res.message}`);
          return;
        }
      } catch (e) {
        console.error("Verification call failed:", e);
      }
    }

    // Local fallback
    if (!item.trusted_reference) {
      item.status = "UNVERIFIED";
      item.verifiedBy = "No Reference Configured";
      alert(`Verification for ${item.source}:\nStatus: UNVERIFIED\nReason: No trusted acquisition hash reference registered.`);
    } else if (item.sha256.toLowerCase() === item.trusted_reference.toLowerCase()) {
      item.status = "VERIFIED";
      item.verifiedBy = "Client-side SHA-256 Match";
      alert(`Verification for ${item.source}:\nStatus: VERIFIED\nMessage: SHA-256 hash strictly matches trusted acquisition reference.`);
    } else {
      item.status = "MISMATCH";
      item.verifiedBy = "Integrity Mismatch";
      alert(`Verification for ${item.source}:\nStatus: MISMATCH\nMessage: INTEGRITY BREACH! Computed hash differs from reference.`);
    }
    renderChainOfCustody();
  };

  function findEvidenceItem(key) {
    if (!state.currentCase || !state.currentCase.evidenceHashes) return null;
    const byId = state.currentCase.evidenceHashes.find(h => h.id === key);
    if (byId) return byId;
    const idx = parseInt(key, 10);
    if (!isNaN(idx) && state.currentCase.evidenceHashes[idx]) {
      return state.currentCase.evidenceHashes[idx];
    }
    return null;
  }

  window.viewAuditHistory = async function(key) {
    const item = findEvidenceItem(key);
    if (!item) return;

    if (el.modalAuditTitle) el.modalAuditTitle.textContent = item.source;
    if (el.modalAuditSubtitle) el.modalAuditSubtitle.textContent = `ID: ${item.id || 'Local Artifact'} | SHA-256: ${item.sha256.substring(0, 16)}...`;

    let history = [];
    let chainValid = true;

    if (state.backendConnected && item.id && !item.id.startsWith("ev-local-")) {
      try {
        const resp = await fetch(`${API_BASE}/evidence/${item.id}/history`);
        if (resp.ok) {
          const data = await resp.json();
          history = data.history || [];
          chainValid = data.chain_valid;
