  function drawReconstructionFrame(customT, customItem) {
    if (!ctx || !el.reconstructionCanvas) return;
    const canvas = el.reconstructionCanvas;
    const w = canvas.width;
    const h = canvas.height;

    // Dark sleek background
    ctx.fillStyle = '#0b0f19';
    ctx.fillRect(0, 0, w, h);

    const t = (customT !== undefined) ? customT : (state.simTime !== undefined ? state.simTime : (state.telemetryData[state.currentIndex] ? state.telemetryData[state.currentIndex].t : -5.0));
    const item = customItem || getInterpolatedTelemetry(t);

    if (state.cameraMode === 'dashcam') {
      drawDashcamVisionView(ctx, w, h, t, item);
    } else if (state.cameraMode === 'isometric') {
      drawIsometricView(ctx, w, h, t, item);
    } else {
      drawTopDownPhysicsScene(ctx, w, h, t, item);
    }

    // Watermark
    ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
    ctx.font = '11px "JetBrains Mono", monospace';
    ctx.fillText(`VIEW: [${state.cameraMode === 'topdown' ? 'TOP VIEW' : state.cameraMode === 'dashcam' ? 'DASHCAM' : '3D VIEW'}] | t = ${t >= 0 ? '+' : ''}${t.toFixed(2)}s | SPEED: ${item.speed.toFixed(1)} km/h`, 16, 22);
  }


  // ==========================================
  // UNIFIED FORENSIC KINEMATICS ENGINE
  // Single source of truth across Top View, Dashcam, and 3D
  // ==========================================
  function getScenarioKinematics(caseId, t, item) {
    const cx = 400;
    const cy = 210;
    const p = Math.max(0, Math.min(1, (t + 5.0) / 5.0));
    const postP = t > 0 ? Math.min(1, t / 2.5) : 0;
    const steer = (item && typeof item.steer === 'number') ? item.steer : 0;
    const yaw = (item && typeof item.yaw === 'number') ? item.yaw : 0;
    const brake = (item && typeof item.brake === 'number') ? item.brake : 0;
    const speed = (item && typeof item.speed === 'number') ? item.speed : 50;

    const kin = {
      caseId: caseId,
      t: t,
      item: item,
      cx: cx,
      cy: cy,
      p: p,
      postP: postP,
      ego: {
        x: cx, y: cy, heading: 0, roll: 0, pitch: 0,
        speed: speed, brake: brake > 15, steer: steer, yaw: yaw,
        label: 'Subject Vehicle', color: '#0284c7', roofColor: '#38bdf8',
        len: 44, wid: 20, height: 16
      },
      target: null,
      actors: [],
      pedestrian: null,
      skidmarks: [],
      impact: { active: (t >= -0.08 && t <= 0.45), x: cx, y: cy, energy: 1.0 },
      milestones: []
    };

    // 0. DATASET-DRIVEN / CUSTOM INGESTED CRASH SCENARIO
    if (caseId.startsWith('CASE_DS_') || caseId.startsWith('SYNTH') || (state.currentCase && state.currentCase.summaryTags && state.currentCase.summaryTags.includes('Dataset Ingestion')) || (item && (typeof item.posX === 'number' || typeof item.position_x_m === 'number'))) {
      const rawX = (item && typeof item.posX === 'number') ? item.posX : ((item && typeof item.position_x_m === 'number') ? item.position_x_m : 0);
      const rawY = (item && typeof item.posY === 'number') ? item.posY : ((item && typeof item.position_y_m === 'number') ? item.position_y_m : 0);
      const rawHeading = (item && typeof item.headingDeg === 'number') ? item.headingDeg : ((item && typeof item.yaw === 'number') ? item.yaw : 0);

      let egoX, egoY, egoHeading;
      if (t <= 2.0) {
        // Pre-impact approach along X-axis to intersection center (cx - 15 = 385)
        const approachP = Math.max(0, Math.min(1, t / 2.0));
        egoX = 75 + (approachP * 310);
        egoY = (cy + 24) - (rawY * 4.0);
        egoHeading = (rawHeading * Math.PI / 180);
      } else {
        // Post-impact deflection northward along Y-axis
        const postFrac = Math.min(1, (t - 2.0) / 1.0);
