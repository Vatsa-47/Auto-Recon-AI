  function drawCar2D(ctx, x, y, angle, bodyColor, roofColor, label, brakeActive = false, len = 44, wid = 20, hazard = false, roll = 0) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);
    if (roll) ctx.scale(Math.cos(roll), 1);

    // Drop shadow
    ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
    ctx.fillRect(-len / 2 - 2, -wid / 2 + 2, len + 4, wid + 4);

    // Wheels
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(-len * 0.35, -wid / 2 - 2, len * 0.22, 3);
    ctx.fillRect(len * 0.15, -wid / 2 - 2, len * 0.22, 3);
    ctx.fillRect(-len * 0.35, wid / 2 - 1, len * 0.22, 3);
    ctx.fillRect(len * 0.15, wid / 2 - 1, len * 0.22, 3);

    // Body
    ctx.fillStyle = bodyColor;
    ctx.fillRect(-len / 2, -wid / 2, len, wid);

    // Roof greenhouse
    ctx.fillStyle = roofColor;
    ctx.fillRect(-len / 4, -wid / 3, len / 2, (wid * 2) / 3);

    // Windshield glass
    ctx.fillStyle = 'rgba(15, 23, 42, 0.7)';
    ctx.fillRect(len * 0.12, -wid / 3 + 1, 4, (wid * 2) / 3 - 2);

    // Brake lights
    if (brakeActive) {
      ctx.fillStyle = '#ef4444';
      ctx.shadowColor = '#f87171';
      ctx.shadowBlur = 8;
      ctx.fillRect(-len / 2 - 2, -wid / 2 + 1, 3, 5);
      ctx.fillRect(-len / 2 - 2, wid / 2 - 6, 3, 5);
      ctx.shadowBlur = 0;
    }

    // Hazard flashers
    if (hazard && Math.floor(Date.now() / 400) % 2 === 0) {
      ctx.fillStyle = '#f59e0b';
      ctx.fillRect(len / 2 - 1, -wid / 2, 3, 3);
      ctx.fillRect(len / 2 - 1, wid / 2 - 3, 3, 3);
      ctx.fillRect(-len / 2 - 2, -wid / 2, 3, 3);
      ctx.fillRect(-len / 2 - 2, wid / 2 - 3, 3, 3);
    }

    ctx.restore();

    if (label) {
      ctx.fillStyle = '#cbd5e1';
      ctx.font = '10px "Plus Jakarta Sans", sans-serif';
      ctx.fillText(label, x - 25, y - wid - 4);
    }
  }

  function drawPedestrian2D(ctx, x, y, heading, walkCycle, isStruck) {
    ctx.save();
    ctx.translate(x, y);

    // Drop shadow
    ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
    ctx.beginPath(); ctx.ellipse(0, 0, 6, 4, 0, 0, Math.PI * 2); ctx.fill();

    // Body
    ctx.fillStyle = '#f59e0b';
    ctx.beginPath(); ctx.arc(0, 0, 5, 0, Math.PI * 2); ctx.fill();

    // Shoulders
    ctx.fillStyle = '#d97706';
    ctx.fillRect(-6, -2, 12, 4);

    // Legs moving if walking
    if (!isStruck && walkCycle) {
      ctx.strokeStyle = '#92400e';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, 0); ctx.lineTo(-walkCycle * 4, -5);
      ctx.moveTo(0, 0); ctx.lineTo(walkCycle * 4, 5);
      ctx.stroke();
    }

    ctx.restore();
    ctx.fillStyle = '#cbd5e1';
    ctx.font = '9px "Plus Jakarta Sans", sans-serif';
    ctx.fillText('Pedestrian', x - 18, y - 9);
  }

