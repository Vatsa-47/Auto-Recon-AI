  function highlightActiveTimelineNode(currentT) {
    if (!el.incidentTimelineTrack) return;
    const nodes = el.incidentTimelineTrack.querySelectorAll('.timeline-milestone-node');
    let closestNode = null;
    let minDiff = Infinity;
    nodes.forEach(node => {
      const nodeT = parseFloat(node.getAttribute('data-t'));
      const diff = Math.abs(nodeT - currentT);
      if (diff < minDiff) {
        minDiff = diff;
        closestNode = node;
      }
    });

    nodes.forEach(node => {
      const circle = node.querySelector('.milestone-circle');
      if (circle) {
        if (node === closestNode && minDiff < 0.6) {
          circle.classList.add('ring-4', 'ring-sky-400', 'scale-115');
        } else {
          circle.classList.remove('ring-4', 'ring-sky-400', 'scale-115');
        }
      }
    });
  }

  // ==========================================
  // TELEMETRY INTERPOLATION
  // ==========================================
  function getInterpolatedTelemetry(t) {
    if (!state.telemetryData || state.telemetryData.length === 0) {
      return { t: t, speed: 0, throttle: 0, brake: 0, steer: 0, yaw: 0, longG: 0, canLoad: 0, canId: '', canPayload: '', anomaly: false, abs: false, notes: '' };
    }
    const data = state.telemetryData;
    // Clamp to data range
    if (t <= data[0].t) return Object.assign({}, data[0]);
    if (t >= data[data.length - 1].t) return Object.assign({}, data[data.length - 1]);
    // Find bracketing points
    let lo = 0, hi = data.length - 1;
    for (let i = 0; i < data.length - 1; i++) {
      if (data[i].t <= t && data[i + 1].t >= t) {
        lo = i; hi = i + 1; break;
      }
    }
    const a = data[lo], b = data[hi];
    const span = b.t - a.t;
    const frac = span > 0 ? (t - a.t) / span : 0;
    const lerp = (v1, v2) => v1 + (v2 - v1) * frac;
    // Use nearest point for discrete fields
    const nearest = frac < 0.5 ? a : b;
    return {
      t: t,
      speed: lerp(a.speed, b.speed),
      throttle: lerp(a.throttle, b.throttle),
      brake: lerp(a.brake, b.brake),
      steer: lerp(a.steer, b.steer),
      yaw: lerp(a.yaw || 0, b.yaw || 0),
      longG: lerp(a.longG, b.longG),
      canLoad: lerp(a.canLoad, b.canLoad),
      canId: nearest.canId || '',
      canPayload: nearest.canPayload || '',
      anomaly: nearest.anomaly || false,
      abs: nearest.abs || false,
      notes: nearest.notes || ''
    };
  }

