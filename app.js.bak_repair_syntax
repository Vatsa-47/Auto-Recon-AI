  async function fetchMLSeverityPrediction(c) {
    if (!c) return;
    try {
      const impactTele = (c.telemetry && c.telemetry.find(t => t.t === 0.0)) || (c.telemetry && c.telemetry[c.telemetry.length - 1]) || {};
      const initialTele = (c.telemetry && c.telemetry[0]) || {};
      const preSpeed = initialTele.speedKph || (c.location && c.location.speedLimit) || 65.0;
      const deltaV = impactTele.accelG ? Math.abs(impactTele.accelG) * 1.8 : 28.5;

      let colType = "ANGLE";
      const scType = (c.scenarioType || "").toLowerCase();
      if (scType.includes("intersection")) colType = "ANGLE";
      else if (scType.includes("rear") || scType.includes("pileup")) colType = "REAR";
      else if (scType.includes("barrier") || scType.includes("exit")) colType = "FRONTAL";

      let roadCond = "DRY";
      const rcStr = (c.location && c.location.roadCondition ? c.location.roadCondition : "").toLowerCase();
      if (rcStr.includes("wet") || rcStr.includes("water")) roadCond = "WET";
      else if (rcStr.includes("ice")) roadCond = "ICY";
      else if (rcStr.includes("snow")) roadCond = "SNOW";

      let vehClass = "SEDAN";
      const modelStr = (c.vehicleInfo && c.vehicleInfo.model ? c.vehicleInfo.model : "").toLowerCase();
      if (modelStr.includes("suv") || modelStr.includes("hauler")) vehClass = "SUV";
      else if (modelStr.includes("truck") || modelStr.includes("semi")) vehClass = "PICKUP";

      const payload = {
        case_id: c.id,
        pre_impact_speed_kph: parseFloat(preSpeed),
        delta_v_kph: parseFloat(deltaV),
        brake_applied: true,
        seatbelt_latched: true,
        airbag_deployed: true,
        collision_type: colType,
        road_condition: roadCond,
        vehicle_weight_class: vehClass
      };

      const resp = await fetch(`${API_BASE}/ml/predict-severity`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      if (resp.ok) {
        const data = await resp.json();
        c.mlSeverityPrediction = data;
        const textEl = document.getElementById("fars-ml-text");
        const badgeEl = document.getElementById("fars-ml-severity-badge");
        if (textEl) {
          const sevLabel = data.predicted_severity_class.replace(/_/g, ' ');
          textEl.textContent = `FARS PyTorch: ${sevLabel} (${Math.round(data.confidence * 100)}%)`;
        }
        if (badgeEl) {
          badgeEl.title = `PyTorch Neural Net Severity: ${data.predicted_severity_class} | Confidence: ${Math.round(data.confidence * 100)}% | Risk Score: ${data.severity_risk_score}/100 | Calibrated on NHTSA FARS 2024 National Census`;
        }
      }

      // Query Crash Pattern Classifier (Model B)
      try {
        const patResp = await fetch(`${API_BASE}/ml/predict-pattern`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            pre_impact_speed_kph: parseFloat(preSpeed),
            delta_v_kph: parseFloat(deltaV),
            brake_applied: true,
            road_condition: roadCond,
            vehicle_weight_class: vehClass
          })
        });
        if (patResp.ok) {
          c.mlPatternPrediction = await patResp.json();
        }
      } catch (err) {}

      // Query Scenario Similarity Engine (Model D)
      try {
        const simResp = await fetch(`${API_BASE}/ml/similar-crashes`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            pre_impact_speed_kph: parseFloat(preSpeed),
            delta_v_kph: parseFloat(deltaV),
            collision_type: colType,
            road_condition: roadCond,
            vehicle_weight_class: vehClass,
            top_k: 3
          })
        });
        if (simResp.ok) {
          c.similarCrashesData = await simResp.json();
        }
      } catch (err) {}
    } catch (e) {
      console.warn("Could not fetch FARS ML prediction:", e);
    }
  }

