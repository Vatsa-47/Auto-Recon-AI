          verification_result: null,
          previous_hash: "0".repeat(64),
          record_hash: item.sha256
        }
      ];
      if (item.trusted_reference) {
        history.push({
          event_id: `evt-local-02`,
          event_type: "REFERENCE_ADDED",
          timestamp: item.timestamp,
          actor_id: "Forensic_Lead",
          details: `Trusted reference registered: ${item.trusted_reference}`,
          verification_result: null,
          previous_hash: item.sha256,
          record_hash: item.trusted_reference
