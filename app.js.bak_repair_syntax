          timestamp: item.timestamp,
          actor_id: "Automated_Verifier",
          details: `Verification result: ${item.status}`,
          verification_result: item.status,
          previous_hash: item.trusted_reference,
          record_hash: item.sha256
        });
      }
    }

    // Render chain status banner
    if (el.modalChainStatus) {
      if (chainValid) {
        el.modalChainStatus.innerHTML = `
