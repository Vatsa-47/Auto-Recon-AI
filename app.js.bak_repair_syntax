  // ==========================================
  // DYNAMIC INVESTIGATOR RECOMMENDATION GENERATOR
  // ==========================================
  function generateDynamicRecommendation(c) {
    if (!c || !c.telemetry) {
      return {
        assessment: "Insufficient evidence",
        assessmentSubtext: "Missing or corrupted vehicle telemetry records",
        confidence: 40.0,
        summary: "The ingested dataset does not contain sufficient synchronized EDR or CAN bus telemetry to reconstruct the incident with forensic confidence.",
        whyReasons: [
          "Fewer than 5 synchronized telemetry points present in ingested record.",
          "Critical safety parameters (braking pressure, wheel speed, CAN arbitration) are unmonitored.",
          "Timestamp alignment across sensor subnets could not be verified."
        ],
        detectedAnomalies: [
          { time: "t = 0.00s", component: "Evidence Ingestion", description: "Telemetry records truncated or incomplete." }
        ],
        recommendedNextSteps: [
          "Request full raw binary EEPROM dump from Bosch CDR or OEM proprietary extraction tool.",
          "Verify physical CAN bus harness connections and re-extract uncorrupted logging files.",
          "Check cryptographic SHA-256 hash match against initial seizure ledger."
        ],
        furtherExaminationEvidence: [
          "Raw binary EDR storage chip (.bin)",
          "OEM diagnostic gateway non-volatile memory"
        ],
        limitations: [
          "Incomplete pre-crash recording buffer window."
        ]
      };
    }

    const tel = c.telemetry;
    const anomalies = tel.filter(t => t.anomaly);
    const maxCanLoad = Math.max(...tel.map(t => t.canLoad || 0));
    const maxThrottle = Math.max(...tel.map(t => t.throttle || 0));
    const maxBrake = Math.max(...tel.map(t => t.brake || 0));
    const maxDecel = Math.min(...tel.map(t => t.longG || 0));

    // Automated multi-factor classification
    let assessment = "Normal vehicle operation";
    let subtext = "Telemetry indicates nominal vehicle behavior within design boundaries";
    let confidence = 88.0;

    if (c.investigatorRecommendation) {
      return c.investigatorRecommendation;
    }

    if (maxCanLoad > 85 && anomalies.length > 1) {
      assessment = "CAN/network anomaly";
      subtext = "Severe vehicle network bus load saturation and message arbitration delay";
      confidence = 92.0;
    } else if (maxThrottle > 80 && maxBrake === 0 && maxDecel > -1.0) {
      assessment = "Driver/physical event";
      subtext = "Full accelerator demand sustained with zero foundation brake application";
      confidence = 94.0;
    } else if (anomalies.length > 0) {
      assessment = "Vehicle/system malfunction";
      subtext = "Subsystem sensor discrepancy or unexpected actuator latency detected";
      confidence = 91.0;
    }

    return {
      assessment,
      assessmentSubtext: subtext,
      confidence,
      summary: `The reconstructed timeline indicates evidence of ${assessment.toLowerCase()}. The available telemetry correlates ${anomalies.length} anomaly event(s) across the vehicle network.`,
      whyReasons: [
        `Correlated telemetry shows peak CAN bus load of ${maxCanLoad}% with ${anomalies.length} flagged anomaly frames.`,
        `Driver input recorded maximum throttle demand of ${maxThrottle}% vs brake application of ${maxBrake} Bar.`,
        `Peak longitudinal deceleration measured at ${maxDecel.toFixed(1)}g during the incident event.`
      ],
      detectedAnomalies: anomalies.map(a => ({
        time: `t = ${a.t >= 0 ? '+' : ''}${a.t.toFixed(1)}s`,
        component: a.canId || "Telemetry Channel",
        description: a.notes || "Sensor or arbitration parameter deviation"
      })),
      recommendedNextSteps: [
        "Review relevant CAN frames and ECU logs around the detected incident timestamp.",
        "Cross-correlate EDR freeze-frame parameters with physical vehicle damage profile.",
        "Perform diagnostic scan for active and historical Diagnostic Trouble Codes (DTCs)."
      ],
      furtherExaminationEvidence: [
        "Chassis and powertrain CAN transceiver logs",
        "Vehicle control module non-volatile memory"
      ],
      limitations: [
        "Real-time sensor timing jitter subject to CAN bus controller clock drift."
      ]
    };
  }

  function updateInvestigatorRecommendation() {
    const c = state.currentCase;
    if (!c) return;

    const rec = c.investigatorRecommendation || generateDynamicRecommendation(c);

    // Classification Badge
    if (el.recClassificationBadge) {
      el.recClassificationBadge.textContent = rec.assessment;
      let cls = 'badge-pill-amber';
      if (rec.assessment === 'Normal vehicle operation') cls = 'badge-pill-emerald';
      else if (rec.assessment === 'Driver/physical event') cls = 'badge-pill-blue';
      else if (rec.assessment === 'Possible cybersecurity-related activity') cls = 'badge-pill-danger';
      else if (rec.assessment === 'CAN/network anomaly') cls = 'badge-pill-amber';
      else if (rec.assessment === 'Insufficient evidence') cls = 'bg-blue-100 text-blue-900 border border-blue-200';
      el.recClassificationBadge.className = `badge-pill ${cls} font-mono text-xs`;
    }

    // Confidence
    if (el.recConfidenceVal) {
      el.recConfidenceVal.textContent = `${Math.round(rec.confidence)}%`;
    }

    // Summary Narrative
    if (el.recSummaryText) {
      el.recSummaryText.textContent = rec.summary;
    }

    // "Why?" Explainable List
    if (el.recWhyList) {
      el.recWhyList.innerHTML = rec.whyReasons.map(r => `
        <li class="flex items-start gap-2">
          <i class="fa-solid fa-arrow-right text-blue-600 text-xs mt-1 shrink-0"></i>
          <span>${r}</span>
        </li>
      `).join('');
    }

    // Detected Anomalies
    if (el.recAnomaliesList) {
      el.recAnomaliesList.innerHTML = rec.detectedAnomalies.map(a => `
        <div class="p-2.5 bg-blue-50/70 rounded-lg border border-blue-200/80 flex items-start justify-between gap-2">
          <div>
            <span class="mono-font text-blue-700 font-bold text-[11px]">${a.time}</span>
            <span class="text-blue-950 font-bold ml-1.5 text-[11px]">${a.component}</span>
            <p class="text-blue-800 text-[10px] mt-0.5">${a.description}</p>
          </div>
          <span class="badge-pill badge-pill-danger text-[9px] shrink-0">FLAGGED</span>
        </div>
      `).join('');
    }

    // Recommended Actions
    if (el.recActionSteps) {
      el.recActionSteps.innerHTML = rec.recommendedNextSteps.map(step => `
        <li class="font-medium text-blue-900">${step}</li>
      `).join('');
    }

    // Evidence for Further Examination
    if (el.recFurtherEvidence) {
      el.recFurtherEvidence.innerHTML = rec.furtherExaminationEvidence.map(item => `
        <li>${item}</li>
      `).join('');
    }

    // Limitations
    if (el.recLimitations) {
      el.recLimitations.innerHTML = rec.limitations.map(lim => `
        <li>${lim}</li>
      `).join('');
    }
  }

