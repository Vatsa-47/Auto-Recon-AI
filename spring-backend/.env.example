# MySQL Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=auto_recon
DB_USER=autorecon_app
DB_PASSWORD=autorecon_secure_password_2026

# Server Port (default: 8080)
SERVER_PORT=8080

# File Storage Directory (relative to spring-backend or absolute)
AUTORECON_STORAGE_DIR=storage
