# AUTO-RECON AI — MySQL & Environment Configuration Example
# Copy this file to .env and configure your local MySQL database credentials.

# Database Connection Settings (MySQL 8.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autorecon_ai
DB_USER=autorecon_app
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Optional Full Connection URL Override (if set, takes precedence)
# DATABASE_URL=mysql+pymysql://autorecon_app:CHANGE_ME_SECURE_PASSWORD@127.0.0.1:3306/autorecon_ai?charset=utf8mb4

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Storage and API Settings
AUTORECON_STORAGE_DIR=backend/storage
API_HOST=127.0.0.1
API_PORT=8000
